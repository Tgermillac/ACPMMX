// ADMIN PAGOS COMPONENT
// ════════════════════════════════════════════════════
function AdminPagos({ db, pilotos, fmt, aprobarPago, rechazarPago, S, C }) {
  const [tabPagos, setTabPagos] = useState("pendientes");
  const [imgModal, setImgModal] = useState(null);
  const pendientes = db.pagos_pendientes || [];
  const acreditados = pilotos.flatMap(([u, v]) => v.pagos.map(p => ({ ...p, nombre: v.nombre, username: u }))).sort((a, b) => b.fecha.localeCompare(a.fecha));

  return (
    <div>
      <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", flexWrap:"wrap", gap:"1rem", marginBottom:"1.5rem" }}>
        <div>
          <h2 style={{ fontWeight:900, fontSize:"1.3rem", color:C.white, margin:0 }}>💳 Pagos</h2>
          <p style={{ color:C.text, fontSize:".85rem", margin:".3rem 0 0" }}>Comprobantes pendientes y pagos acreditados</p>
        </div>
        {pendientes.length > 0 && (
          <div style={{ background:`${C.yellow}18`, border:`1px solid ${C.yellow}40`, borderRadius:"999px", padding:".35rem .9rem", fontSize:".8rem", fontWeight:700, color:C.yellow }}>
            ⏳ {pendientes.length} pendiente{pendientes.length > 1 ? "s" : ""}
          </div>
        )}
      </div>

      {/* Tabs */}
      <div style={{ display:"flex", gap:".5rem", marginBottom:"1.5rem" }}>
        {[["pendientes", "⏳ Pendientes", pendientes.length], ["acreditados","✅ Acreditados", acreditados.length]].map(([id, label, count]) => (
          <button key={id} onClick={() => setTabPagos(id)} style={{
            background: tabPagos===id ? C.accent : "transparent",
            color: tabPagos===id ? "#fff" : C.text,
            border:`1px solid ${tabPagos===id ? C.accent : C.border}`,
            padding:".45rem 1rem", borderRadius:"8px", cursor:"pointer", fontWeight:700, fontSize:".82rem",
            display:"flex", alignItems:"center", gap:".4rem",
          }}>
            {label}
            <span style={{ background: tabPagos===id ? "rgba(255,255,255,.25)" : C.surface, borderRadius:"999px", padding:".05rem .45rem", fontSize:".72rem" }}>{count}</span>
          </button>
        ))}
      </div>

      {/* Pendientes */}
      {tabPagos === "pendientes" && (
        pendientes.length === 0 ? (
          <div style={{ ...S.card, textAlign:"center", padding:"3rem", color:C.muted }}>
            <div style={{ fontSize:"2rem", marginBottom:".75rem" }}>✅</div>
            Sin comprobantes pendientes de revisión.
          </div>
        ) : (
          <div style={{ display:"flex", flexDirection:"column", gap:"1rem" }}>
            {pendientes.map(p => (
              <div key={p.id} style={{ ...S.card, borderLeft:`3px solid ${C.yellow}` }}>
                <div style={{ display:"flex", justifyContent:"space-between", alignItems:"flex-start", flexWrap:"wrap", gap:"1rem" }}>
                  <div>
                    <div style={{ fontWeight:800, color:C.white, fontSize:".95rem" }}>{p.nombre}</div>
                    <div style={{ color:C.text, fontSize:".8rem", marginTop:".2rem" }}>
                      <span style={S.tag}>{p.tipo}</span>
                      <strong style={{ color:C.accent, marginLeft:".5rem" }}>{fmt(p.monto)}</strong>
                      <span style={{ color:C.muted, marginLeft:".5rem" }}>· {p.fecha}</span>
                    </div>
                  </div>
                  <div style={{ display:"flex", gap:".6rem", flexWrap:"wrap" }}>
                    <button onClick={() => aprobarPago(p.id)}
                      style={{ ...S.btn(C.green), fontSize:".8rem", padding:".5rem 1rem" }}>✅ Aprobar</button>
                    <button onClick={() => rechazarPago(p.id)}
                      style={{ ...S.btn(C.red), fontSize:".8rem", padding:".5rem 1rem" }}>❌ Rechazar</button>
                  </div>
                </div>

                {/* Verificación IA */}
                {p.verificacion && (
                  <div style={{ marginTop:".85rem", background:`${p.verificacion.ok ? C.green : C.yellow}08`, border:`1px solid ${p.verificacion.ok ? C.green : C.yellow}25`, borderRadius:"8px", padding:".7rem 1rem", fontSize:".8rem" }}>
                    <span style={{ fontWeight:700, color: p.verificacion.ok ? C.green : C.yellow }}>
                      {p.verificacion.ok ? "🤖 IA: Comprobante verificado" : "🤖 IA: Revisar manualmente"}
                    </span>
                    <span style={{ color:C.text, marginLeft:".5rem" }}>{p.verificacion.mensaje}</span>
                    <div style={{ display:"flex", gap:".75rem", marginTop:".4rem" }}>
                      {[
                        ["Fecha correcta", p.verificacion.fecha_ok],
                        ["Monto correcto", p.verificacion.monto_ok],
                        ["Parece real", p.verificacion.real],
                      ].map(([l, v]) => (
                        <span key={l} style={{ fontSize:".72rem", color: v ? C.green : C.red }}>
                          {v ? "✅" : "⚠️"} {l}
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                {/* Imagen comprobante */}
                {p.imgBase64 && (
                  <div style={{ marginTop:".85rem" }}>
                    <img
                      src={"data:" + p.imgMime + ";base64," + p.imgBase64}
                      alt="comprobante"
                      onClick={() => setImgModal(p)}
                      style={{ maxHeight:"120px", borderRadius:"8px", cursor:"pointer", border:`1px solid ${C.border}`, objectFit:"cover" }}
                    />
                    <div style={{ color:C.muted, fontSize:".7rem", marginTop:".3rem" }}>Tocá para ampliar</div>
                  </div>
                )}
              </div>
            ))}
          </div>
        )
      )}

      {/* Acreditados */}
      {tabPagos === "acreditados" && (
        <div style={{ ...S.card, padding:0, overflow:"auto" }}>
          <table style={{ width:"100%", borderCollapse:"collapse", minWidth:"480px" }}>
            <thead><tr>{["Piloto","Tipo","Monto","Fecha","Código"].map(h => <th key={h} style={S.th}>{h}</th>)}</tr></thead>
            <tbody>
              {acreditados.length === 0 && <tr><td colSpan={5} style={{...S.td, textAlign:"center", color:C.muted, padding:"2rem"}}>Sin pagos acreditados aún.</td></tr>}
              {acreditados.map(p => (
                <tr key={p.id + p.username}>
                  <td style={S.td}><div style={{ fontWeight:700, color:C.white }}>{p.nombre}</div></td>
                  <td style={S.td}><span style={S.tag}>{p.tipo}</span></td>
                  <td style={S.td}><strong style={{ color:C.accent }}>{fmt(p.monto)}</strong></td>
                  <td style={S.td}>{p.fecha}</td>
                  <td style={S.td}><code style={{ fontSize:".72rem", color:C.muted }}>{p.codigo}</code></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {/* Modal imagen ampliada */}
      {imgModal && (
        <div onClick={() => setImgModal(null)} style={{ position:"fixed", inset:0, background:"rgba(0,0,0,.85)", zIndex:999, display:"flex", alignItems:"center", justifyContent:"center", padding:"1rem" }}>
          <div onClick={e => e.stopPropagation()} style={{ background:C.card, borderRadius:"16px", padding:"1.5rem", maxWidth:"560px", width:"100%" }}>
            <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:"1rem" }}>
              <div>
                <div style={{ fontWeight:800, color:C.white }}>{imgModal.nombre}</div>
                <div style={{ color:C.text, fontSize:".8rem" }}>{imgModal.tipo} · {fmt(imgModal.monto)} · {imgModal.fecha}</div>
              </div>
              <button onClick={() => setImgModal(null)} style={{ background:"none", border:"none", color:C.muted, cursor:"pointer", fontSize:"1.3rem" }}>✕</button>
            </div>
            <img src={"data:" + imgModal.imgMime + ";base64," + imgModal.imgBase64} alt="comprobante"
              style={{ width:"100%", borderRadius:"10px", objectFit:"contain", maxHeight:"60vh" }} />
            <div style={{ display:"flex", gap:".75rem", marginTop:"1rem" }}>
              <button onClick={() => { aprobarPago(imgModal.id); setImgModal(null); }}
                style={{ ...S.btn(C.green), flex:1 }}>✅ Aprobar pago</button>
              <button onClick={() => { rechazarPago(imgModal.id); setImgModal(null); }}
                style={{ ...S.btn(C.red), flex:1 }}>❌ Rechazar</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

