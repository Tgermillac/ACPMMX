        <div>
          <div style={{ color:C.text, fontSize:".82rem", marginBottom:"1.25rem", lineHeight:1.65 }}>
            Guardá los ajustes que funcionan <strong style={{color:C.white}}>para tu peso y tu moto</strong>. Se guardan por separado para cada combinación de marca y rango de peso.
          </div>

          <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit,minmax(270px,1fr))", gap:"1rem", marginBottom:"1.25rem" }}>
            {/* Delantera */}
            <div style={S.card}>
              <div style={{ fontWeight:700, color:"#60A5FA", marginBottom:"1rem", fontSize:".85rem" }}>🔱 Horquilla Delantera</div>
              {[
                { key:"miSag",     label:"SAG",                 ph: base?.sag || "100-105mm", unit:"mm"     },
                { key:"miAlt",     label:"Altura en táculas",   ph: base?.altHorq || "Flush",  unit:"mm"     },
                { key:"miCompDel", label:"Compresión",          ph: base?.compDel || "—",      unit:"clicks" },
                { key:"miRebDel",  label:"Rebote",              ph: base?.rebDel || "—",       unit:"clicks" },
              ].map(({ key, label, ph, unit }) => (
                <div key={key} style={{ marginBottom:".85rem" }}>
                  <label style={{ ...S.label, display:"flex", justifyContent:"space-between" }}>
                    <span>{label}</span>
                    <span style={{ color:C.muted, fontWeight:400 }}>Base: {ph}</span>
                  </label>
                  <div style={{ display:"flex", gap:".5rem", alignItems:"center" }}>
                    <input style={{ ...S.input, marginBottom:0, flex:1 }} placeholder={ph}
                      value={form[key]||""} onChange={e => setForm(p => ({...p, [key]:e.target.value}))} />
                    <span style={{ color:C.muted, fontSize:".75rem", minWidth:"40px" }}>{unit}</span>
                  </div>
                </div>
              ))}
            </div>

            {/* Trasera */}
            <div style={S.card}>
              <div style={{ fontWeight:700, color:colorMarca, marginBottom:"1rem", fontSize:".85rem" }}>🔩 Amortiguador Trasero</div>
              {[
                { key:"miCompTrasL", label:"Compresión lenta",   ph: base?.compTras || "—",     unit:"clicks" },
                { key:"miCompTrasR", label:"Compresión rápida",  ph: base?.compTras ? String(Math.max(1,parseInt(base.compTras)-3)) : "—", unit:"clicks" },
                { key:"miRebTras",   label:"Rebote",             ph: base?.rebTras || "—",      unit:"clicks" },
                { key:"miPrecarT",   label:"Precarga (vueltas)", ph:"0",                         unit:"vueltas"},
              ].map(({ key, label, ph, unit }) => (
                <div key={key} style={{ marginBottom:".85rem" }}>
                  <label style={{ ...S.label, display:"flex", justifyContent:"space-between" }}>
                    <span>{label}</span>
                    <span style={{ color:C.muted, fontWeight:400 }}>Base: {ph}</span>
                  </label>
                  <div style={{ display:"flex", gap:".5rem", alignItems:"center" }}>
                    <input style={{ ...S.input, marginBottom:0, flex:1 }} placeholder={ph}
                      value={form[key]||""} onChange={e => setForm(p => ({...p, [key]:e.target.value}))} />
                    <span style={{ color:C.muted, fontSize:".75rem", minWidth:"40px" }}>{unit}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Notas */}
          <div style={{ ...S.card, marginBottom:"1.25rem" }}>
            <label style={S.label}>📝 Notas personales de setup</label>
            <textarea style={{ ...S.input, minHeight:"80px", resize:"vertical", marginBottom:0 }}
              placeholder="Ej: Con estas configuraciones la moto se siente más estable en los whoops del sector 2..."
              value={form.notas||""} onChange={e => setForm(p => ({...p, notas:e.target.value}))} />
          </div>

          {/* Seteos guardados anteriores */}
          {Object.keys(misSeteos).length > 0 && (
            <div style={{ ...S.card, marginBottom:"1.25rem" }}>
              <div style={{ fontWeight:700, color:C.white, marginBottom:".85rem", fontSize:".85rem" }}>📚 Seteos guardados</div>
              <div style={{ display:"flex", flexWrap:"wrap", gap:".5rem" }}>
                {Object.entries(misSeteos).map(([k, v]) => {
                  const [marca, rangoPeso] = k.split("_");
                  const isActive = k === seteoKey;
                  return (
                    <button key={k}
                      onClick={() => { setMarcaSelec(marca); setForm(v); }}
                      style={{
                        background: isActive ? `${colorMarca}18` : C.surface,
                        border:`1px solid ${isActive ? colorMarca : C.border}`,
                        color: isActive ? colorMarca : C.text,
                        borderRadius:"8px", padding:".4rem .85rem", cursor:"pointer", fontSize:".78rem", fontWeight:600,
                      }}>
                      {marca} · {rangoPeso}
                    </button>
                  );
                })}
              </div>
            </div>
          )}

          <button onClick={guardarSeteo}
            style={{ ...S.btn(colorMarca), boxShadow:`0 4px 15px ${colorMarca}30`, width:"100%", padding:".85rem", fontSize:".9rem" }}>
            💾 Guardar mis ajustes para {marcaSelec} · {rango}
          </button>
        </div>
      )}
    </Seccion>
  );
}

