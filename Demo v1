    KTM:       ["SX 85","SX 125","SX 250","250 SX-F","350 SX-F","450 SX-F","300 XC","250 XC-F"],
    Husqvarna: ["TC 85","TC 125","TC 250","FC 250","FC 350","FC 450","TX 300","FX 350"],
    Kawasaki:  ["KX85","KX100","KX112","KX250","KX450","KX250X","KX450X"],
    Suzuki:    ["RM85","RM125","RM250","RMZ250","RMZ450"],
    GasGas:    ["MC 85","MC 125","MC 250","MC 250F","MC 350F","MC 450F","EC 250","EC 300"],
  };

  const genInfo = getGenInfo(marcaSelec, motoModelo, motoAno);

  // ── Rango de peso ──
  const getRango = (kg) => {
    if (kg < 40)  return "< 40kg";
    if (kg <= 60) return "40-60kg";
    if (kg <= 75) return "60-75kg";
    if (kg <= 90) return "75-90kg";
    return "90kg+";
  };
  const rango = getRango(peso);

  // ── Base de seteos por marca y rango ──
  // Formato: { sag, altHorq, compDel, rebDel, compTras, rebTras, nota }
  const SETEOS_BASE = {
    Yamaha: {
      "40-60kg": { sag:"105-110mm", altHorq:"Flush", compDel:"15", rebDel:"12", compTras:"13", rebTras:"11", nota:"YZ85/YZ125: suavizar al máximo. Resorte trasero liviano recomendado." },
      "60-75kg": { sag:"100-105mm", altHorq:"Flush a +2mm", compDel:"12", rebDel:"10", compTras:"11", rebTras:"10", nota:"Setup estándar de fábrica YZF. Buen punto de partida para todos los circuitos." },
      "75-90kg": { sag:"95-102mm",  altHorq:"+3mm",          compDel:"10", rebDel:"8",  compTras:"9",  rebTras:"8",  nota:"Ajuste de resorte recomendado (0.48N/mm delantero). Más compresión base." },
      "90kg+":   { sag:"90-98mm",   altHorq:"+5mm",          compDel:"8",  rebDel:"6",  compTras:"7",  rebTras:"6",  nota:"Resorte delantero 0.50+ y trasero más duro. Consultar mecánico." },
    },
    Honda: {
      "40-60kg": { sag:"108-112mm", altHorq:"Flush",         compDel:"16", rebDel:"13", compTras:"14", rebTras:"12", nota:"CRF150/250R juvenil. Mantener presión de aceite baja en horquilla." },
      "60-75kg": { sag:"102-107mm", altHorq:"Flush a +2mm",  compDel:"13", rebDel:"11", compTras:"12", rebTras:"10", nota:"Setup fábrica CRF250R/450R. Sólido en pistas mixtas." },
      "75-90kg": { sag:"97-104mm",  altHorq:"+3mm",          compDel:"11", rebDel:"9",  compTras:"10", rebTras:"8",  nota:"Aumentar precarga trasera 1 vuelta. Rebote delantero más lento." },
      "90kg+":   { sag:"92-100mm",  altHorq:"+4mm",          compDel:"9",  rebDel:"7",  compTras:"8",  rebTras:"7",  nota:"Resorte 5.4+ atrás. Revisar aceite de horquilla (más viscoso)." },
    },
    KTM: {
      "40-60kg": { sag:"106-111mm", altHorq:"Flush",         compDel:"20", rebDel:"17", compTras:"18", rebTras:"16", nota:"SX 85/125: horquilla WP muy reactiva. Abrir compresión bastante." },
      "60-75kg": { sag:"100-106mm", altHorq:"Flush a +2mm",  compDel:"17", rebDel:"15", compTras:"16", rebTras:"14", nota:"WP XACT setup estándar. Clicks desde cerrado (sentido horario)." },
      "75-90kg": { sag:"95-103mm",  altHorq:"+3mm",          compDel:"14", rebDel:"12", compTras:"13", rebTras:"11", nota:"Cerrar 2-3 clicks compresión base. Muy eficaz en pistas duras." },
      "90kg+":   { sag:"90-98mm",   altHorq:"+5mm",          compDel:"12", rebDel:"10", compTras:"11", rebTras:"9",  nota:"Kit de resortes pesados recomendado. Consultar dealer KTM." },
    },
    Husqvarna: {
      "40-60kg": { sag:"106-111mm", altHorq:"Flush",         compDel:"20", rebDel:"17", compTras:"18", rebTras:"16", nota:"TC 85/125: mismo setup base que KTM. Válvulas XACT idénticas." },
      "60-75kg": { sag:"100-106mm", altHorq:"Flush a +2mm",  compDel:"17", rebDel:"15", compTras:"16", rebTras:"14", nota:"FC 250/350/450: WP XACT con mapa AER. Ajustar presión de aire." },
      "75-90kg": { sag:"95-103mm",  altHorq:"+3mm",          compDel:"14", rebDel:"12", compTras:"13", rebTras:"11", nota:"Presión cámara de aire: 10.5-11 bar. Muy sensible al peso." },
      "90kg+":   { sag:"90-98mm",   altHorq:"+5mm",          compDel:"12", rebDel:"10", compTras:"11", rebTras:"9",  nota:"Aumentar presión AER a 11.5+ bar. Rebote trasero más cerrado." },
    },
    Kawasaki: {
      "40-60kg": { sag:"107-112mm", altHorq:"Flush",         compDel:"14", rebDel:"12", compTras:"13", rebTras:"11", nota:"KX85/100: suavizar al máximo. Rebote muy lento para estabilidad." },
      "60-75kg": { sag:"101-107mm", altHorq:"Flush a +2mm",  compDel:"12", rebDel:"10", compTras:"11", rebTras:"9",  nota:"KX250F/450F fábrica. Horquilla Showa muy lineal y predecible." },
      "75-90kg": { sag:"96-103mm",  altHorq:"+3mm",          compDel:"10", rebDel:"8",  compTras:"9",  rebTras:"7",  nota:"Cerrar compresión alta Showa. Revisar nivel aceite horquilla." },
      "90kg+":   { sag:"91-99mm",   altHorq:"+4mm",          compDel:"8",  rebDel:"6",  compTras:"7",  rebTras:"6",  nota:"Resorte 0.50+ Showa. Mecánico especializado recomendado." },
    },
    Suzuki: {
      "40-60kg": { sag:"106-111mm", altHorq:"Flush",         compDel:"15", rebDel:"13", compTras:"14", rebTras:"12", nota:"RM85: setup suave. Aceite 5W en horquilla para ligereza." },
      "60-75kg": { sag:"100-106mm", altHorq:"Flush a +2mm",  compDel:"13", rebDel:"11", compTras:"12", rebTras:"10", nota:"RMZ250/450: horquilla KYB muy ajustable. Setup fábrica confiable." },
      "75-90kg": { sag:"95-103mm",  altHorq:"+3mm",          compDel:"11", rebDel:"9",  compTras:"10", rebTras:"8",  nota:"Cerrar 2 clicks compresión lenta. KYB responde muy bien al ajuste." },
      "90kg+":   { sag:"90-98mm",   altHorq:"+4mm",          compDel:"9",  rebDel:"7",  compTras:"8",  rebTras:"6",  nota:"Kit spring KYB recomendado. Cambiar aceite a 7.5W." },
    },
    GasGas: {
      "40-60kg": { sag:"106-111mm", altHorq:"Flush",         compDel:"20", rebDel:"17", compTras:"18", rebTras:"16", nota:"MC 85/125: plataforma KTM. WP idéntico. Abrir mucho al inicio." },
      "60-75kg": { sag:"100-106mm", altHorq:"Flush a +2mm",  compDel:"17", rebDel:"15", compTras:"16", rebTras:"14", nota:"MC/EC 250/350: mismo setup base que KTM SX/XC. Muy confiable." },
      "75-90kg": { sag:"95-103mm",  altHorq:"+3mm",          compDel:"14", rebDel:"12", compTras:"13", rebTras:"11", nota:"Idéntico a KTM en plataforma. Ajustar precarga atrás 1 vuelta extra." },
      "90kg+":   { sag:"90-98mm",   altHorq:"+5mm",          compDel:"12", rebDel:"10", compTras:"11", rebTras:"9",  nota:"Mismas recomendaciones que KTM 90kg+. Resortes pesados." },
    },
  };

  const marcas = ["Yamaha","Honda","KTM","Husqvarna","Kawasaki","Suzuki","GasGas"];
  const marcaColores = { Yamaha:"#003087", Honda:"#E40521", KTM:"#FF6600", Husqvarna:"#1B3A6B", Kawasaki:"#009A44", Suzuki:"#004B8D", GasGas:"#E4001C" };

  const base = SETEOS_BASE[marcaSelec]?.[rango] || SETEOS_BASE[marcaSelec]?.["60-75kg"];

  // Nivel adjustment — modifica clicks según experiencia del piloto
  const nivelAjuste = { Principiante: +3, Intermedio: 0, Avanzado: -2, Pro: -4 };
  const nivelDesc = {
    Principiante: "Suspensión más suave y predecible. Más compresión abierta para absorber errores.",
    Intermedio:   "Setup base de fábrica. Buen balance entre confort y rendimiento.",
    Avanzado:     "Más firme. La moto responde rápido y el piloto puede manejar la reactividad.",
    Pro:          "Setup competición. Máxima respuesta, mínima tolerancia a errores.",
  };
  const ajuste = nivelAjuste[nivelSelec] ?? 0;
  const ajustarClicks = (val, paramKey) => {
    const n = parseInt(val);
    if (isNaN(n)) return val;
    const genAdj = (genInfo?.clicksAdj?.[paramKey]) || 0;
    return String(Math.max(1, n + ajuste + genAdj));
  };
  const nivelColores = { Principiante: C.teal, Intermedio: C.yellow, Avanzado: C.accent, Pro: "#A855F7" };
  const nivelColor = nivelColores[nivelSelec] || C.teal;

  const PARAMS = [
    { key:"sag",     label:"SAG (Rider SAG)",         unit:"mm",    desc:"Compresión de la suspensión con el piloto arriba" },
    { key:"altHorq", label:"Altura en táculas",        unit:"mm",    desc:"Cuánto sobresale la horquilla por encima del trepied" },
    { key:"compDel", label:"Compresión delantera",     unit:"clicks", desc:"Clicks desde cerrado — controla resistencia a la compresión" },
    { key:"rebDel",  label:"Rebote delantero",         unit:"clicks", desc:"Clicks desde cerrado — velocidad de recuperación horquilla" },
    { key:"compTras",label:"Compresión trasera",       unit:"clicks", desc:"Clicks desde cerrado — soporte en compresas traseras" },
    { key:"rebTras", label:"Rebote trasero",           unit:"clicks", desc:"Clicks desde cerrado — recuperación del amortiguador trasero" },
  ];

  const colorMarca = marcaColores[marcaSelec] || C.accent;

  return (
    <Seccion titulo="🔧 Suspensión" sub={`Seteos para ${nivelSelec} · ${rango} · ${marcaSelec}`}>

      {/* ── CABECERA: Peso + Marca ── */}
      <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit,minmax(200px,1fr))", gap:"1rem", marginBottom:"1.5rem" }}>

        {/* Peso */}
        <div style={S.card}>
          <div style={{ fontWeight:700, color:C.white, marginBottom:"1rem", fontSize:".88rem", display:"flex", alignItems:"center", gap:".5rem" }}>
            ⚖️ Tu peso
          </div>
          <div style={{ display:"flex", gap:".75rem", alignItems:"center" }}>
            <div style={{ flex:1 }}>
              <input
                type="number" min="30" max="150"
                value={pesoEdit}
                onChange={e => setPesoEdit(e.target.value)}
                placeholder="Ej: 75"
                style={{ ...S.input, fontSize:"1.5rem", fontWeight:900, color:C.accent, textAlign:"center", padding:".75rem", marginBottom:0 }}
              />
              <div style={{ color:C.muted, fontSize:".72rem", textAlign:"center", marginTop:".3rem" }}>kilogramos</div>
            </div>
            <button onClick={guardarPeso}
              style={{ ...S.btn(C.teal,"#000"), fontWeight:800, padding:".75rem 1rem", whiteSpace:"nowrap" }}>
              Guardar
            </button>
          </div>
          <div style={{ marginTop:".85rem", background:`${C.teal}10`, border:`1px solid ${C.teal}25`, borderRadius:"8px", padding:".5rem .75rem" }}>
            <div style={{ fontSize:".72rem", color:C.muted, marginBottom:".15rem" }}>Rango actual</div>
            <div style={{ fontWeight:800, color:C.teal, fontSize:".9rem" }}>{rango}</div>
          </div>
        </div>

        {/* Nivel */}
        <div style={S.card}>
          <div style={{ fontWeight:700, color:C.white, marginBottom:"1rem", fontSize:".88rem" }}>🎯 Tu nivel de pilotaje</div>
          <div style={{ display:"flex", flexDirection:"column", gap:".5rem" }}>
            {[
              { id:"Principiante", ic:"🟢", desc:"Estoy aprendiendo" },
              { id:"Intermedio",   ic:"🟡", desc:"Tengo experiencia" },
              { id:"Avanzado",     ic:"🟠", desc:"Compito o entreno seguido" },
              { id:"Pro",          ic:"🔴", desc:"Competición / alto rendimiento" },
            ].map(({ id, ic, desc }) => {
              const col = nivelColores[id] || C.teal;
              const active = nivelSelec === id;
              return (
                <button key={id} onClick={() => guardarNivel(id)} style={{
                  background: active ? `${col}18` : "transparent",
                  border: `1.5px solid ${active ? col : C.border}`,
                  borderRadius:"9px", padding:".55rem .85rem",
                  cursor:"pointer", textAlign:"left",
                  display:"flex", alignItems:"center", gap:".6rem",
                  transition:".15s",
                }}>
                  <span style={{ fontSize:"1rem" }}>{ic}</span>
                  <div>
                    <div style={{ fontWeight:700, color: active ? col : C.textHi, fontSize:".82rem" }}>{id}</div>
                    <div style={{ color:C.muted, fontSize:".7rem" }}>{desc}</div>
                  </div>
                  {active && <span style={{ marginLeft:"auto", color:col, fontSize:".75rem", fontWeight:700 }}>✓</span>}
                </button>
              );
            })}
          </div>
        </div>

        {/* Marca */}
        <div style={S.card}>
          <div style={{ fontWeight:700, color:C.white, marginBottom:"1rem", fontSize:".88rem" }}>🏍️ Marca de tu moto</div>
          <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fill,minmax(90px,1fr))", gap:".5rem" }}>
            {marcas.map(m => (
              <button key={m} onClick={() => { setMarcaSelec(m); setForm(misSeteos[m+"_"+peso] || {}); setMotoModelo(""); }}
                style={{
                  background: marcaSelec===m ? marcaColores[m] : C.surface,
                  border:`2px solid ${marcaSelec===m ? marcaColores[m] : C.border}`,
                  color: marcaSelec===m ? "#fff" : C.text,
                  borderRadius:"8px", padding:".45rem .5rem", cursor:"pointer",
                  fontWeight:700, fontSize:".78rem", transition:".15s",
                }}>
                {m}
              </button>
            ))}
          </div>
          <div style={{ marginTop:".85rem", fontSize:".75rem", color:C.muted }}>
            Moto registrada: <strong style={{color:C.textHi}}>{piloto.moto || "No especificada"}</strong>
          </div>
        </div>

        {/* Año + Modelo */}
        <div style={S.card}>
          <div style={{ fontWeight:700, color:C.white, marginBottom:"1rem", fontSize:".88rem" }}>📅 Año y modelo exacto</div>
          <div style={{ marginBottom:".85rem" }}>
            <label style={S.label}>Año de fabricación</label>
            <input type="number" min="2000" max="2026" placeholder="Ej: 2022"
              style={{ ...S.input, fontSize:"1.2rem", fontWeight:800, color:colorMarca, textAlign:"center", marginBottom:0 }}
              value={motoAno} onChange={e => setMotoAno(e.target.value)} />
          </div>
          <div style={{ marginBottom:".85rem" }}>
            <label style={S.label}>Modelo</label>
            <select style={{ ...S.input, marginBottom:0 }}
              value={motoModelo} onChange={e => setMotoModelo(e.target.value)}>
              <option value="">Seleccioná modelo...</option>
              {(MODELOS[marcaSelec] || []).map(m => <option key={m} value={m}>{m}</option>)}
            </select>
          </div>
          <button onClick={guardarPeso}
            style={{ ...S.btn(colorMarca), fontWeight:800, width:"100%", padding:".6rem" }}>
            💾 Guardar moto
          </button>
          {genInfo && (
            <div style={{ marginTop:".85rem", background:`${colorMarca}10`, border:`1px solid ${colorMarca}25`, borderRadius:"8px", padding:".6rem .75rem" }}>
              <div style={{ fontSize:".72rem", fontWeight:700, color:colorMarca, marginBottom:".2rem" }}>
                {genInfo.gen} · {genInfo.horquilla}
              </div>
              {genInfo.aer && (
                <div style={{ fontSize:".72rem", color:C.yellow, fontWeight:700, marginBottom:".2rem" }}>
                  💨 AER: {genInfo.aerPresion}
                </div>
              )}
            </div>
          )}
        </div>
      </div>

      {/* ── TABS ── */}
      <div style={{ display:"flex", gap:".5rem", marginBottom:"1.25rem" }}>
        {[["recomendado","📋 Recomendado"],["misajustes","✏️ Mis ajustes"]].map(([id,label]) => (
          <button key={id} onClick={() => setTabSusp(id)} style={{
            background: tabSusp===id ? colorMarca : "transparent",
            color: tabSusp===id ? "#fff" : C.text,
            border:`1px solid ${tabSusp===id ? colorMarca : C.border}`,
            padding:".45rem 1rem", borderRadius:"8px", cursor:"pointer", fontWeight:700, fontSize:".82rem",
          }}>{label}</button>
        ))}
      </div>

      {/* ── TAB: RECOMENDADO ── */}
      {tabSusp === "recomendado" && base && (
        <div>
          {/* Banner generación/año */}
          {genInfo && (
            <div style={{ marginBottom:"1.25rem" }}>
              <div style={{ background:`${colorMarca}10`, border:`1px solid ${colorMarca}30`, borderRadius:"12px", padding:"1rem 1.1rem" }}>
                <div style={{ display:"flex", alignItems:"center", gap:".6rem", marginBottom:".6rem", flexWrap:"wrap" }}>
                  <span style={{ background:colorMarca, color:"#fff", fontWeight:900, fontSize:".75rem", padding:".2rem .65rem", borderRadius:"999px" }}>
                    {motoModelo || marcaSelec} {motoAno}
                  </span>
                  <span style={{ background:`${C.blue}15`, color:"#93C5FD", fontWeight:700, fontSize:".72rem", padding:".2rem .65rem", borderRadius:"999px" }}>
                    {genInfo.gen}
                  </span>
                  <span style={{ color:C.muted, fontSize:".72rem" }}>{genInfo.horquilla} · {genInfo.amort}</span>
                </div>
                <p style={{ color:C.textHi, fontSize:".82rem", lineHeight:1.65, margin:0 }}>{genInfo.nota}</p>
                {genInfo.nota2 && <p style={{ color:C.yellow, fontSize:".78rem", lineHeight:1.6, margin:".5rem 0 0", fontStyle:"italic" }}>{genInfo.nota2}</p>}
                {genInfo.break_in && (
                  <div style={{ marginTop:".6rem", background:`${C.yellow}12`, border:`1px solid ${C.yellow}25`, borderRadius:"8px", padding:".5rem .75rem", fontSize:".78rem", color:C.yellow, display:"flex", alignItems:"center", gap:".5rem" }}>
                    ⏱️ <strong>Break-in requerido:</strong> {genInfo.break_in}
                  </div>
                )}
                {genInfo.aer && (
                  <div style={{ marginTop:".5rem", background:`${C.teal}10`, border:`1px solid ${C.teal}25`, borderRadius:"8px", padding:".5rem .75rem", fontSize:".78rem", color:C.teal, display:"flex", alignItems:"center", gap:".5rem" }}>
                    💨 <strong>Presión de aire AER recomendada:</strong> {genInfo.aerPresion}
                  </div>
                )}
              </div>
            </div>
          )}

          {/* Nota de marca + nivel */}
          <div style={{ ...S.card, borderLeft:`3px solid ${colorMarca}`, marginBottom:"1.25rem", background:`linear-gradient(135deg, ${C.card}, ${C.cardHi})` }}>
            <div style={{ display:"flex", alignItems:"center", gap:".6rem", marginBottom:".75rem", flexWrap:"wrap" }}>
              <div style={{ background:colorMarca, color:"#fff", fontWeight:900, fontSize:".78rem", padding:".25rem .7rem", borderRadius:"999px" }}>{marcaSelec}</div>
              <div style={{ background:`${C.teal}15`, color:C.teal, fontWeight:700, fontSize:".75rem", padding:".25rem .7rem", borderRadius:"999px" }}>{rango}</div>
              <div style={{ background:`${nivelColor}18`, border:`1px solid ${nivelColor}40`, color:nivelColor, fontWeight:700, fontSize:".75rem", padding:".25rem .7rem", borderRadius:"999px" }}>
                {nivelSelec}
              </div>
              {ajuste !== 0 && (
                <div style={{ color:C.muted, fontSize:".72rem" }}>
                  {ajuste > 0 ? `+${ajuste} clicks (más suave)` : `${ajuste} clicks (más firme)`}
                </div>
              )}
            </div>
            <p style={{ color:C.text, fontSize:".82rem", lineHeight:1.65, margin:"0 0 .6rem" }}>{base.nota}</p>
            <p style={{ color:nivelColor, fontSize:".79rem", lineHeight:1.6, margin:0, fontStyle:"italic" }}>{nivelDesc[nivelSelec]}</p>
          </div>

          {/* Tabla de parámetros */}
          <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit,minmax(270px,1fr))", gap:"1rem", marginBottom:"1.25rem" }}>

            {/* Delantera */}
            <div style={{ ...S.card, padding:0, overflow:"hidden" }}>
              <div style={{ background:`#2563EB20`, borderBottom:`1px solid #2563EB30`, padding:".75rem 1rem", fontWeight:700, color:"#60A5FA", fontSize:".82rem" }}>
                🔱 Horquilla Delantera
              </div>
              {[
                { label:"SAG (Rider SAG)", val:base.sag, unit:"", key:"sag" },
                { label:"Altura en táculas", val:base.altHorq, unit:"", key:"altHorq" },
                { label:"Compresión", val:ajustarClicks(base.compDel,"compDel"), unit:" clicks", key:"compDel" },
                { label:"Rebote", val:ajustarClicks(base.rebDel,"rebDel"), unit:" clicks", key:"rebDel" },
              ].map(({ label, val, unit }) => (
                <div key={label} style={{ padding:".65rem 1rem", borderBottom:`1px solid ${C.border}20`, display:"flex", justifyContent:"space-between", alignItems:"center" }}>
                  <div>
                    <div style={{ fontWeight:600, fontSize:".82rem", color:C.textHi }}>{label}</div>
                    <div style={{ color:C.muted, fontSize:".7rem" }}>{PARAMS.find(p=>p.label===label)?.desc || ""}</div>
                  </div>
                  <span style={{ background:`#2563EB15`, border:`1px solid #2563EB30`, color:"#60A5FA", padding:".2rem .65rem", borderRadius:"8px", fontWeight:800, fontSize:".85rem", whiteSpace:"nowrap", marginLeft:".5rem" }}>
                    {val}{unit}
                  </span>
                </div>
              ))}
            </div>

            {/* Trasera */}
            <div style={{ ...S.card, padding:0, overflow:"hidden" }}>
              <div style={{ background:`${colorMarca}20`, borderBottom:`1px solid ${colorMarca}30`, padding:".75rem 1rem", fontWeight:700, color:colorMarca, fontSize:".82rem" }}>
                🔩 Amortiguador Trasero
              </div>
              {[
                { label:"SAG (Rider SAG)", val:base.sag, unit:"" },
                { label:"Compresión lenta", val:ajustarClicks(base.compTras,"compTras"), unit:" clicks" },
                { label:"Compresión rápida", val:String(Math.max(1,parseInt(ajustarClicks(base.compTras,"compTras"))-3)), unit:" clicks" },
                { label:"Rebote", val:ajustarClicks(base.rebTras,"rebTras"), unit:" clicks" },
              ].map(({ label, val, unit }) => (
                <div key={label} style={{ padding:".65rem 1rem", borderBottom:`1px solid ${C.border}20`, display:"flex", justifyContent:"space-between", alignItems:"center" }}>
                  <div>
                    <div style={{ fontWeight:600, fontSize:".82rem", color:C.textHi }}>{label}</div>
                  </div>
                  <span style={{ background:`${colorMarca}15`, border:`1px solid ${colorMarca}30`, color:colorMarca, padding:".2rem .65rem", borderRadius:"8px", fontWeight:800, fontSize:".85rem", whiteSpace:"nowrap", marginLeft:".5rem" }}>
