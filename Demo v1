                    <div style={{ color: C.textHi, fontSize: ".82rem" }}>{transVerif?.mensaje}</div>
                  </div>
                  <div style={{ color: C.muted, fontSize: ".78rem", marginBottom: "1.25rem" }}>
                    El admin recibirá una notificación. Generalmente se confirma en pocas horas.
                  </div>
                  <button style={{ ...S.btn(C.accent), width: "100%", boxShadow: `0 4px 15px ${C.accent}30` }}
                    onClick={() => { setTransFlow(null); setTransImg(null); setTransVerif(null); }}>
                    Volver al inicio
                  </button>
                </div>
              )}
            </Seccion>
          )}

          {/* ── PILOTO: HISTORIAL ── */}
          {!isAdmin && sideTab === "historial" && piloto && (
            <Seccion titulo="📋 Mis pagos" sub="Historial completo de tus pagos en ACPM">
              {piloto.pagos.length === 0 ? (
                <div style={{ ...S.card, textAlign: "center", padding: "2.5rem", color: C.text }}>
                  Sin pagos registrados aún.
                  <br />
                  <button style={{ ...S.btn(C.accent), marginTop: "1rem" }} onClick={() => setSideTab("pagar")}>Hacer mi primer pago</button>
                </div>
              ) : (
                <div style={{ display: "flex", flexDirection: "column", gap: "1rem" }}>
                  {piloto.pagos.map(p => (
                    <div key={p.id} style={{ ...S.card, display: "flex", alignItems: "center", gap: "1rem", flexWrap: "wrap" }}>
                      <QRCode codigo={p.codigo} size={56} />
                      <div style={{ flex: 1 }}>
                        <div style={{ fontWeight: 700, color: C.white }}>{p.tipo === "Mensual" ? "Abono Mensual" : "Día de Pista"}</div>
                        <code style={{ fontSize: ".72rem", color: C.muted }}>{p.codigo}</code>
                        <div style={{ color: C.muted, fontSize: ".75rem" }}>{p.fecha}</div>
                      </div>
                      <div style={{ textAlign: "right" }}>
                        <div style={{ fontWeight: 900, color: C.accent, fontSize: "1.1rem" }}>{fmt(p.monto)}</div>
                        <span style={S.badge(true)}>✅ Acreditado</span>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </Seccion>
          )}

          {/* ── PILOTO: ENTRENAMIENTOS ── */}
          {!isAdmin && sideTab === "entrenamientos" && piloto && (
            <EntrenamientosSection piloto={piloto} db={db} setDb={setDb} session={session} setSession={setSession} />
          )}

          {/* ── PILOTO: SUSPENSIÓN ── */}
          {!isAdmin && sideTab === "suspension" && piloto && (
            <SuspensionSection piloto={piloto} session={session} db={db} setDb={setDb} showToast={showToast} />
          )}

          {/* ── CARRERAS ADMIN ── */}
          {isAdmin && sideTab === "carreras" && (
            <CarrerasAdmin
              db={db} today={today} fmt={fmt} categorias={categorias}
              carreraForm={carreraForm} setCarreraForm={setCarreraForm}
              crearCarrera={crearCarrera} cambiarEstadoCarrera={cambiarEstadoCarrera}
              marcarPresente={marcarPresente} descargarListaPDF={descargarListaPDF}
              subirResultados={subirResultados} S={S} C={C}
            />
          )}

          {/* ── CARRERAS PILOTO ── */}
          {!isAdmin && sideTab === "carreras" && piloto && (
            <CarrerasPiloto
              db={db} piloto={piloto} session={session} today={today} fmt={fmt}
              inscripcionFlow={inscripcionFlow} setInscripcionFlow={setInscripcionFlow}
              inscripcionDorsal={inscripcionDorsal} setInscripcionDorsal={setInscripcionDorsal}
              inscribirse={inscribirse} S={S} C={C}
            />
          )}

          {/* ── REGLAMENTO / NORMAS ── */}
          {sideTab === "normas" && (
            <NormasConvivencia C={C} S={S} />
          )}

          {/* ── MI PERFIL PILOTO ── */}
          {!isAdmin && sideTab === "perfil" && piloto && (
            <PerfilPiloto
              piloto={piloto} session={session}
              perfilEdit={perfilEdit} setPerfilEdit={setPerfilEdit}
              perfilForm={perfilForm} setPerfilForm={setPerfilForm}
              guardarPerfil={guardarPerfil} S={S} C={C}
            />
          )}

        </main>
      </div>

      {/* BOTTOM NAV — mobile only */}
      {isMobile && (
        <nav style={{
          position: "fixed", bottom: 0, left: 0, right: 0,
          background: isDark ? C.sideBar : "#1A237E",
          borderTop: `1px solid rgba(255,255,255,.12)`,
          display: "flex", justifyContent: "space-around", alignItems: "center",
          padding: ".4rem 0", zIndex: 100,
          paddingBottom: "env(safe-area-inset-bottom, .4rem)",
          boxSizing: "border-box",
        }}>
          {menu.slice(0, 5).map(({ id, ic, label }) => (
            <button key={id} onClick={() => setSideTab(id)} style={{
              background: sideTab === id ? "rgba(255,69,0,.18)" : "none",
              border: "none",
              display: "flex", flexDirection: "column", alignItems: "center", gap: ".15rem",
              color: sideTab === id ? C.accent : "rgba(255,255,255,.7)",
              cursor: "pointer", padding: ".3rem .4rem", borderRadius: "8px",
              transition: "all .15s", flex: 1,
            }}>
              <span style={{ fontSize: "1.15rem", opacity: sideTab === id ? 1 : 0.7 }}>{ic}</span>
              <span style={{ fontSize: ".52rem", fontWeight: sideTab === id ? 800 : 500, textTransform: "uppercase", letterSpacing: ".3px", lineHeight: 1 }}>{label}</span>
            </button>
          ))}
          {menu.length > 5 && (
            <button onClick={() => {
              const extra = menu.slice(5);
              const next = extra.find(m => m.id !== sideTab) || extra[0];
              setSideTab(next.id);
            }} style={{
              background: menu.slice(5).some(m => m.id === sideTab) ? "rgba(255,69,0,.18)" : "none",
              border: "none", flex: 1,
              display: "flex", flexDirection: "column", alignItems: "center", gap: ".15rem",
              color: menu.slice(5).some(m => m.id === sideTab) ? C.accent : "rgba(255,255,255,.7)",
              cursor: "pointer", padding: ".3rem .4rem", borderRadius: "8px",
            }}>
              <span style={{ fontSize: "1.15rem", opacity: 0.7 }}>⋯</span>
              <span style={{ fontSize: ".52rem", fontWeight: 500, textTransform: "uppercase", letterSpacing: ".3px" }}>Más</span>
            </button>
          )}
        </nav>
      )}

      {/* MODAL PAGO ADMIN */}
      {pagoModal && (
        <div style={{ position: "fixed", inset: 0, background: "rgba(0,0,0,.7)", display: "flex", alignItems: "center", justifyContent: "center", zIndex: 300, padding: "1rem" }}>
          <div style={{ ...S.card, maxWidth: "380px", width: "100%", boxShadow: "0 30px 80px rgba(0,0,0,.5)" }}>
            <div style={{ fontWeight: 800, color: C.white, marginBottom: "1rem" }}>Registrar pago — {db.users[pagoModal.username]?.nombre}</div>
            <label style={S.label}>Tipo</label>
            <select style={S.input} value={pagoForm.tipo} onChange={e => { const t = e.target.value; setPagoForm(p => ({ ...p, tipo: t, monto: t === "Mensual" ? PRECIO_MES : PRECIO_DIA })); }}>
              <option>Mensual</option><option>Día</option>
            </select>
            <label style={S.label}>Monto</label>
            <input style={S.input} type="number" value={pagoForm.monto} onChange={e => setPagoForm(p => ({ ...p, monto: e.target.value }))} />
            <label style={S.label}>Fecha</label>
            <input style={S.input} type="date" value={pagoForm.fecha} onChange={e => setPagoForm(p => ({ ...p, fecha: e.target.value }))} />
            <div style={{ display: "flex", gap: ".75rem" }}>
              <button style={{ ...S.btn(C.accent), flex: 1 }} onClick={() => agregarPagoAdmin(pagoModal.username)}>✅ Registrar</button>
              <button style={{ ...S.btn(C.surface, C.text), border: `1px solid ${C.border}` }} onClick={() => setPagoModal(null)}>Cancelar</button>
            </div>
          </div>
        </div>
      )}

      {/* TOAST */}
      {toast && (
        <div style={{
          position: "fixed", bottom: "1.5rem", left: "50%", transform: "translateX(-50%)",
          background: C.card, color: C.white, padding: ".75rem 1.4rem", borderRadius: "10px",
          fontWeight: 600, fontSize: ".85rem", zIndex: 400,
          boxShadow: "0 8px 30px rgba(0,0,0,.4)", border: `1px solid ${C.border}`,
        }}>{toast}</div>
      )}
    </div>
  );
}
