// CARRERAS ADMIN COMPONENT
// ════════════════════════════════════════════════════
function CarrerasAdmin({ db, today, fmt, categorias, carreraForm, setCarreraForm,
  crearCarrera, cambiarEstadoCarrera, marcarPresente, descargarListaPDF, subirResultados, S, C }) {
  const [vista, setVista] = useState("lista"); // lista | crear | detalle
  const [carreraSelec, setCarreraSelec] = useState(null);
  const [tabDetalle, setTabDetalle] = useState("inscriptos");

  const estadoColor = { abierta: C.green, cerrada: C.yellow, finalizada: C.muted };
  const estadoLabel = { abierta: "✅ Abierta", cerrada: "🔒 Cerrada", finalizada: "🏁 Finalizada" };

  const handleResultFile = (e, carreraId) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => subirResultados(carreraId, ev.target.result, file.name);
    reader.readAsDataURL(file);
  };

  if (vista === "crear") return (
    <div>
      <button onClick={() => setVista("lista")} style={{ background:"none", border:"none", color:C.teal, cursor:"pointer", fontWeight:700, fontSize:".85rem", marginBottom:"1.25rem", display:"flex", alignItems:"center", gap:".4rem" }}>
        ← Volver a carreras
      </button>
      <div style={{ fontWeight:900, fontSize:"1.3rem", color:C.white, marginBottom:"1.5rem" }}>🏁 Crear nueva carrera</div>

      <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit,minmax(280px,1fr))", gap:"1.5rem" }}>
        <div style={S.card}>
          <div style={{ fontWeight:700, color:C.white, marginBottom:"1rem", fontSize:".88rem" }}>📋 Información general</div>
          <label style={S.label}>Título de la carrera *</label>
          <input style={S.input} placeholder="Ej: Fecha #3 Campeonato 2026" value={carreraForm.titulo}
            onChange={e => setCarreraForm(p => ({...p, titulo:e.target.value}))} />
          <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:".75rem" }}>
            <div>
              <label style={S.label}>Fecha *</label>
              <input style={S.input} type="date" value={carreraForm.fecha}
                onChange={e => setCarreraForm(p => ({...p, fecha:e.target.value}))} />
            </div>
            <div>
              <label style={S.label}>Hora de largada</label>
              <input style={S.input} type="time" value={carreraForm.hora}
                onChange={e => setCarreraForm(p => ({...p, hora:e.target.value}))} />
            </div>
          </div>
          <label style={S.label}>Descripción</label>
          <textarea style={{...S.input, minHeight:"80px", resize:"vertical"}} placeholder="Detalles de la carrera..."
            value={carreraForm.descripcion} onChange={e => setCarreraForm(p => ({...p, descripcion:e.target.value}))} />
        </div>

        <div style={S.card}>
          <div style={{ fontWeight:700, color:C.white, marginBottom:"1rem", fontSize:".88rem" }}>💰 Precio por categoría</div>
          <div style={{ display:"flex", flexDirection:"column", gap:".5rem" }}>
            {carreraForm.categorias.map((c, i) => (
              <div key={c.cat} style={{ display:"flex", alignItems:"center", gap:".75rem" }}>
                <input type="checkbox" checked={c.habilitada}
                  onChange={e => setCarreraForm(p => ({ ...p, categorias: p.categorias.map((x,j) => j===i ? {...x,habilitada:e.target.checked} : x) }))}
                  style={{ accentColor:C.accent, width:"16px", height:"16px" }} />
                <span style={{ minWidth:"80px", fontSize:".82rem", color:c.habilitada?C.textHi:C.muted, fontWeight:600 }}>{c.cat}</span>
                <input type="number" disabled={!c.habilitada}
                  style={{ ...S.input, marginBottom:0, flex:1, opacity:c.habilitada?1:.4, padding:".4rem .75rem" }}
                  value={c.precio}
                  onChange={e => setCarreraForm(p => ({ ...p, categorias: p.categorias.map((x,j) => j===i ? {...x,precio:Number(e.target.value)} : x) }))} />
                <span style={{ fontSize:".72rem", color:C.muted, minWidth:"30px" }}>{c.precio===0?"GRATIS":""}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div style={{ marginTop:"1.5rem", display:"flex", gap:"1rem" }}>
        <button style={{ ...S.btn(C.accent), padding:".8rem 2rem", fontSize:".9rem", boxShadow:`0 4px 15px ${C.accent}30` }}
          onClick={() => { crearCarrera(); setVista("lista"); }}>
          🏁 Crear carrera
        </button>
        <button style={{ ...S.btn(C.surface, C.text), border:`1px solid ${C.border}` }}
          onClick={() => setVista("lista")}>Cancelar</button>
      </div>
    </div>
  );

  if (vista === "detalle" && carreraSelec) {
    const carrera = db.carreras.find(c => c.id === carreraSelec);
    if (!carrera) return null;
    const inscriptos = carrera.inscriptos.map(ins => ({ ...ins, user: db.users[ins.username] || {} }));
    const presentes = inscriptos.filter(i => i.presente).length;

    return (
      <div>
        <button onClick={() => setVista("lista")} style={{ background:"none", border:"none", color:C.teal, cursor:"pointer", fontWeight:700, fontSize:".85rem", marginBottom:"1.25rem" }}>
          ← Volver a carreras
        </button>

        <div style={{ display:"flex", justifyContent:"space-between", alignItems:"flex-start", flexWrap:"wrap", gap:"1rem", marginBottom:"1.5rem" }}>
          <div>
            <h2 style={{ fontWeight:900, fontSize:"1.3rem", color:C.white, margin:0 }}>{carrera.titulo}</h2>
            <div style={{ color:C.text, fontSize:".85rem", marginTop:".3rem" }}>📅 {carrera.fecha} · ⏰ {carrera.hora}</div>
          </div>
          <div style={{ display:"flex", gap:".6rem", flexWrap:"wrap" }}>
            <button style={{ ...S.btn(), fontSize:".8rem", padding:".5rem 1rem", display:"flex", alignItems:"center", gap:".4rem" }}
              onClick={() => descargarListaPDF(carrera)}>
              <Download size={14}/> Descargar PDF
            </button>
            {carrera.estado === "abierta" && <button style={{ ...S.btn(C.yellow, "#000"), fontSize:".8rem", padding:".5rem 1rem" }} onClick={() => cambiarEstadoCarrera(carrera.id, "cerrada")}>🔒 Cerrar inscripción</button>}
            {carrera.estado === "cerrada" && <button style={{ ...S.btn(C.green), fontSize:".8rem", padding:".5rem 1rem" }} onClick={() => cambiarEstadoCarrera(carrera.id, "abierta")}>✅ Reabrir</button>}
            {carrera.estado !== "finalizada" && <button style={{ ...S.btn(C.muted, C.white), fontSize:".8rem", padding:".5rem 1rem" }} onClick={() => cambiarEstadoCarrera(carrera.id, "finalizada")}>🏁 Finalizar</button>}
          </div>
        </div>

        {/* Stats */}
        <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit,minmax(120px,1fr))", gap:".85rem", marginBottom:"1.5rem" }}>
          {[
            [inscriptos.length, "Inscriptos", C.teal],
            [presentes, "Presentes", C.green],
            [inscriptos.length - presentes, "Ausentes", C.muted],
            [inscriptos.filter(i=>i.pagado).length, "Pagaron", C.accent],
          ].map(([v,l,c]) => (
            <div key={l} style={{ ...S.card, textAlign:"center" }}>
              <div style={{ fontSize:"1.8rem", fontWeight:900, color:c }}>{v}</div>
              <div style={{ fontSize:".72rem", color:C.muted, textTransform:"uppercase", letterSpacing:".5px" }}>{l}</div>
            </div>
          ))}
        </div>

        {/* Tabs */}
        <div style={{ display:"flex", gap:".5rem", marginBottom:"1.25rem" }}>
          {[["inscriptos","👥 Inscriptos"],["resultados","🏆 Resultados"]].map(([id,label]) => (
            <button key={id} onClick={() => setTabDetalle(id)} style={{
              background: tabDetalle===id ? C.accent : "transparent",
              color: tabDetalle===id ? "#fff" : C.text,
              border:`1px solid ${tabDetalle===id ? C.accent : C.border}`,
              padding:".45rem 1rem", borderRadius:"8px", cursor:"pointer", fontWeight:700, fontSize:".82rem"
            }}>{label}</button>
          ))}
        </div>

        {tabDetalle === "inscriptos" && (
          <div style={{ ...S.card, padding:0, overflow:"hidden" }}>
            <table style={{ width:"100%", borderCollapse:"collapse" }}>
              <thead><tr>
                {["Dorsal","Piloto","Cat.","DNI","Obra Social","Emergencia","Pagó","Presente"].map(h =>
                  <th key={h} style={S.th}>{h}</th>)}
              </tr></thead>
              <tbody>
                {inscriptos.length === 0 && (
                  <tr><td colSpan={8} style={{ ...S.td, textAlign:"center", color:C.muted, padding:"2rem" }}>Sin inscriptos aún.</td></tr>
                )}
                {inscriptos.map((ins, i) => (
                  <tr key={ins.username}>
                    <td style={S.td}><span style={{ fontWeight:900, color:C.accent, fontSize:"1rem" }}>#{ins.dorsal||"—"}</span></td>
                    <td style={S.td}>
                      <div style={{ fontWeight:700, color:C.white }}>{ins.user.nombre||ins.username}</div>
                      <div style={{ color:C.muted, fontSize:".7rem" }}>{ins.user.moto||""} {ins.user.esMenor?"👶 Menor":""}</div>
                    </td>
                    <td style={S.td}><span style={S.tag}>{ins.user.categoria||"—"}</span></td>
                    <td style={S.td}><span style={{ color:C.text, fontSize:".8rem" }}>{ins.user.dni||"—"}</span></td>
                    <td style={S.td}><span style={{ color:C.text, fontSize:".8rem" }}>{ins.user.obraSocial||"—"}</span></td>
                    <td style={S.td}>
                      <div style={{ fontSize:".78rem", color:C.textHi }}>{ins.user.emergenciaNombre||"—"}</div>
                      <div style={{ fontSize:".7rem", color:C.teal }}>{ins.user.emergenciaTel||""}</div>
                      {ins.user.esMenor && <div style={{ fontSize:".7rem", color:C.yellow }}>Tutor: {ins.user.tutorNombre||"—"}</div>}
                    </td>
                    <td style={S.td}><span style={S.badge(ins.pagado)}>{ins.pagado?"✅":"❌"}</span></td>
                    <td style={S.td}>
                      <button onClick={() => marcarPresente(carrera.id, ins.username, !ins.presente)} style={{
                        background: ins.presente ? `${C.green}18` : "transparent",
                        border:`1.5px solid ${ins.presente ? C.green : C.border}`,
                        color: ins.presente ? C.green : C.muted,
                        borderRadius:"8px", padding:".35rem .75rem", cursor:"pointer", fontWeight:700, fontSize:".78rem"
                      }}>
                        {ins.presente ? "✅ Presente" : "☐ Marcar"}
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {tabDetalle === "resultados" && (
          <div style={S.card}>
            <div style={{ fontWeight:700, color:C.white, marginBottom:"1rem" }}>🏆 Resultados de la carrera</div>
            {carrera.resultados ? (
              <div>
                <div style={{ background:C.surface, border:`1px solid ${C.border}`, borderRadius:"10px", padding:"1rem", marginBottom:"1rem", display:"flex", alignItems:"center", gap:"1rem" }}>
                  <FileText size={28} style={{ color:C.teal }} />
                  <div style={{ flex:1 }}>
                    <div style={{ color:C.white, fontWeight:700 }}>{carrera.resultados.nombre}</div>
                    <div style={{ color:C.muted, fontSize:".75rem" }}>Archivo cargado</div>
                  </div>
                  <a href={carrera.resultados.url} target="_blank" rel="noreferrer"
                    style={{ ...S.btn(C.teal,"#000"), fontSize:".78rem", textDecoration:"none" }}>Ver</a>
                </div>
                <label style={{ ...S.btn(C.surface, C.text), border:`1px solid ${C.border}`, cursor:"pointer", display:"inline-block" }}>
                  📎 Reemplazar archivo
                  <input type="file" accept="image/*,.pdf" style={{ display:"none" }} onChange={e => handleResultFile(e, carrera.id)} />
                </label>
              </div>
            ) : (
              <div style={{ textAlign:"center", padding:"2rem 1rem" }}>
                <Trophy size={40} style={{ color:C.muted, opacity:.4, marginBottom:"1rem" }} />
                <div style={{ color:C.text, marginBottom:"1.25rem" }}>Subí la foto o PDF con los resultados de la carrera</div>
                <label style={{ ...S.btn(C.accent), cursor:"pointer", display:"inline-block" }}>
                  📎 Subir resultados
                  <input type="file" accept="image/*,.pdf" style={{ display:"none" }} onChange={e => handleResultFile(e, carrera.id)} />
                </label>
              </div>
            )}
          </div>
        )}
      </div>
    );
  }

  // ── LISTA DE CARRERAS ──
  return (
    <div>
      <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:"1.5rem", flexWrap:"wrap", gap:"1rem" }}>
        <div>
          <h2 style={{ fontWeight:900, fontSize:"1.3rem", color:C.white, margin:0 }}>🏁 Gestión de carreras</h2>
          <p style={{ color:C.text, fontSize:".85rem", margin:".3rem 0 0" }}>Creá carreras, gestioná inscripciones y descargá listas</p>
        </div>
        <button style={{ ...S.btn(C.accent), boxShadow:`0 4px 15px ${C.accent}30`, display:"flex", alignItems:"center", gap:".5rem" }}
          onClick={() => setVista("crear")}>
          <Flag size={15}/> Nueva carrera
        </button>
      </div>

      {db.carreras.length === 0 ? (
        <div style={{ ...S.card, textAlign:"center", padding:"3rem" }}>
          <Flag size={40} style={{ color:C.muted, opacity:.3, marginBottom:"1rem", display:"block", margin:"0 auto 1rem" }} />
          <div style={{ color:C.text }}>No hay carreras creadas todavía.</div>
        </div>
      ) : (
        <div style={{ display:"flex", flexDirection:"column", gap:"1rem" }}>
          {db.carreras.map(c => (
            <div key={c.id} style={{ ...S.card, borderLeft:`3px solid ${estadoColor[c.estado]||C.muted}`, cursor:"pointer" }}
              onClick={() => { setCarreraSelec(c.id); setVista("detalle"); setTabDetalle("inscriptos"); }}>
              <div style={{ display:"flex", justifyContent:"space-between", alignItems:"flex-start", flexWrap:"wrap", gap:".75rem" }}>
                <div>
                  <div style={{ fontWeight:800, color:C.white, fontSize:".95rem" }}>{c.titulo}</div>
                  <div style={{ color:C.text, fontSize:".8rem", marginTop:".2rem" }}>📅 {c.fecha} · ⏰ {c.hora}</div>
                  {c.descripcion && <div style={{ color:C.muted, fontSize:".75rem", marginTop:".2rem" }}>{c.descripcion}</div>}
                </div>
                <div style={{ display:"flex", gap:".6rem", alignItems:"center", flexWrap:"wrap" }}>
                  <span style={S.badge(c.estado==="abierta", estadoColor[c.estado])}>{estadoLabel[c.estado]}</span>
                  <span style={{ ...S.tag }}>{c.inscriptos.length} inscriptos</span>
                  <span style={{ color:C.muted, fontSize:".75rem" }}>→</span>
                </div>
              </div>
              <div style={{ display:"flex", gap:".5rem", marginTop:".85rem", flexWrap:"wrap" }}>
                {c.categorias.slice(0,5).map(cat => (
                  <span key={cat.cat} style={{ ...S.tag, background:`${C.accent}10`, borderColor:`${C.accent}20`, color:C.accent }}>
                    {cat.cat} · {cat.precio===0?"Gratis":fmt(cat.precio)}
                  </span>
                ))}
                {c.categorias.length > 5 && <span style={{ ...S.tag, color:C.muted }}>+{c.categorias.length-5}</span>}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

