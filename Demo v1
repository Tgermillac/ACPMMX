// ── Entrenamientos Section ───────────────────────────
function EntrenamientosSection({ piloto, db, setDb, session, setSession }) {
  const [nivelLocal, setNivelLocal] = useState(piloto.nivel);
  const [diaAbierto, setDiaAbierto] = useState(0);
  const [bloqueAbierto, setBloqueAbierto] = useState("principal");
  const plan = PLANES_ENTRENAMIENTO[nivelLocal] || PLANES_ENTRENAMIENTO["Principiante"];

  const cambiarNivel = n => {
    setNivelLocal(n);
    setDb(d => ({ ...d, users: { ...d.users, [session.username]: { ...d.users[session.username], nivel: n } } }));
    setSession(p => ({ ...p, nivel: n }));
    setDiaAbierto(0);
  };

  const rpeColor = rpe => {
    const n = parseInt(rpe);
    if (n >= 9) return C.red;
    if (n >= 7) return C.accent;
    if (n >= 5) return C.yellow;
    return C.teal;
  };

  const BloqueEjercicios = ({ ejercicios, titulo, ic }) => (
    ejercicios.length > 0 ? (
      <div style={{ marginBottom: "1.2rem" }}>
        <div style={{ fontWeight: 700, color: C.white, fontSize: ".85rem", marginBottom: ".75rem" }}>{ic} {titulo}</div>
        <div style={{ display: "flex", flexDirection: "column", gap: ".6rem" }}>
          {ejercicios.map((e, i) => (
            <div key={i} style={{ ...S.card, padding: "1rem", borderLeft: `3px solid ${plan.color}` }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: ".5rem", flexWrap: "wrap", gap: ".4rem" }}>
                <div style={{ fontWeight: 700, color: C.white, fontSize: ".88rem" }}>{e.ej}</div>
                <div style={{ display: "flex", gap: ".4rem", flexWrap: "wrap" }}>
                  <span style={{ ...S.tag }}>📋 {e.series} series</span>
                  <span style={{ background: `${C.teal}12`, border: `1px solid ${C.teal}20`, color: C.teal, padding: ".18rem .55rem", borderRadius: "6px", fontSize: ".7rem", fontWeight: 700 }}>🔁 {e.reps}</span>
                  {e.rpe !== "—" && <span style={{ background: `${rpeColor(e.rpe)}12`, border: `1px solid ${rpeColor(e.rpe)}20`, color: rpeColor(e.rpe), padding: ".18rem .55rem", borderRadius: "6px", fontSize: ".7rem", fontWeight: 700 }}>RPE {e.rpe}</span>}
                </div>
              </div>
              <div style={{ background: C.surface, borderRadius: "8px", padding: ".65rem .85rem", fontSize: ".8rem", color: C.text, lineHeight: 1.65 }}>
                <span style={{ color: C.teal, fontWeight: 700 }}>📖 Técnica: </span>{e.tecnica}
              </div>
            </div>
          ))}
        </div>
      </div>
    ) : null
  );

  return (
    <Seccion titulo="💪 Entrenamientos" sub="Plan detallado adaptado a tu nivel y objetivos">
      <div style={{ ...S.cardGlow(plan.color), marginBottom: "1.5rem" }}>
        <div style={{ fontWeight: 700, color: C.white, marginBottom: ".75rem", fontSize: ".88rem" }}>🎯 Tu nivel actual</div>
        <div style={{ display: "flex", gap: ".6rem", flexWrap: "wrap" }}>
          {nivelesMoto.map(n => (
            <button key={n} onClick={() => cambiarNivel(n)} style={{
              background: nivelLocal === n ? plan.color : "transparent",
              color: nivelLocal === n ? "#fff" : C.text,
              border: `1.5px solid ${nivelLocal === n ? plan.color : C.border}`,
              padding: ".45rem 1rem", borderRadius: "8px", cursor: "pointer",
              fontWeight: 700, fontSize: ".82rem", transition: ".15s",
            }}>{n}</button>
          ))}
        </div>
        {nivelLocal !== piloto.nivel && <div style={{ color: C.teal, fontSize: ".75rem", marginTop: ".5rem" }}>✅ Nivel actualizado</div>}
      </div>

      <div style={{ ...S.card, borderLeft: `4px solid ${plan.color}`, marginBottom: "1.5rem" }}>
        <div style={{ display: "flex", gap: "2rem", flexWrap: "wrap" }}>
          <div><div style={{ color: C.muted, fontSize: ".7rem", fontWeight: 700, textTransform: "uppercase", marginBottom: ".2rem" }}>Objetivo</div><div style={{ color: C.textHi, fontSize: ".88rem" }}>{plan.objetivo}</div></div>
          <div><div style={{ color: C.muted, fontSize: ".7rem", fontWeight: 700, textTransform: "uppercase", marginBottom: ".2rem" }}>Frecuencia</div><div style={{ color: C.textHi, fontSize: ".88rem" }}>{plan.frecuencia}</div></div>
        </div>
        <div style={{ background: `${C.yellow}10`, border: `1px solid ${C.yellow}25`, borderRadius: "8px", padding: ".65rem .9rem", marginTop: "1rem", fontSize: ".8rem", color: C.yellow }}>
          ⚠️ {plan.nota}
        </div>
      </div>

      <div style={{ display: "flex", gap: ".5rem", flexWrap: "wrap", marginBottom: "1.5rem" }}>
        {plan.dias.map((d, i) => (
          <button key={i} onClick={() => { setDiaAbierto(i); setBloqueAbierto("principal"); }} style={{
            background: diaAbierto === i ? plan.color : "transparent",
            color: diaAbierto === i ? "#fff" : C.text,
            border: `1.5px solid ${diaAbierto === i ? plan.color : C.border}`,
            padding: ".45rem .9rem", borderRadius: "8px", cursor: "pointer",
            fontWeight: 700, fontSize: ".78rem", transition: ".15s",
          }}>
            {d.dia}<br /><span style={{ fontSize: ".65rem", fontWeight: 400, opacity: .8 }}>{d.tipo}</span>
          </button>
        ))}
      </div>

      {plan.dias[diaAbierto] && (() => {
        const d = plan.dias[diaAbierto];
        return (
          <div>
            <div style={{ ...S.cardGlow(plan.color), marginBottom: "1.2rem", display: "flex", justifyContent: "space-between", alignItems: "center", flexWrap: "wrap", gap: ".5rem" }}>
              <div>
                <div style={{ fontWeight: 900, color: plan.color, fontSize: "1rem" }}>{d.dia} — {d.tipo}</div>
                <div style={{ color: C.text, fontSize: ".8rem" }}>Duración estimada: {d.duracion}</div>
              </div>
              <div style={{ display: "flex", gap: ".5rem" }}>
                {[["calentamiento", "🔥 Calentamiento"], ["principal", "💪 Principal"], ["vuelta", "🧘 Vuelta"]].map(([b, l]) => (
                  <button key={b} onClick={() => setBloqueAbierto(b)} style={{
                    background: bloqueAbierto === b ? plan.color : "transparent",
                    color: bloqueAbierto === b ? "#fff" : C.text,
                    border: `1px solid ${bloqueAbierto === b ? plan.color : C.border}`,
                    padding: ".35rem .7rem", borderRadius: "6px", cursor: "pointer", fontWeight: 700, fontSize: ".72rem",
                  }}>{l}</button>
                ))}
              </div>
            </div>
            {bloqueAbierto === "calentamiento" && <BloqueEjercicios ejercicios={d.calentamiento} titulo="Calentamiento" ic="🔥" />}
            {bloqueAbierto === "principal" && <BloqueEjercicios ejercicios={d.principal} titulo="Bloque principal" ic="💪" />}
            {bloqueAbierto === "vuelta" && <BloqueEjercicios ejercicios={d.vuelta} titulo="Vuelta a la calma" ic="🧘" />}
            {((bloqueAbierto === "calentamiento" && d.calentamiento.length === 0) || (bloqueAbierto === "vuelta" && d.vuelta.length === 0)) && (
              <div style={{ ...S.card, textAlign: "center", padding: "2rem", color: C.text }}>No hay ejercicios específicos en este bloque.</div>
            )}
          </div>
        );
      })()}
    </Seccion>
  );
}




