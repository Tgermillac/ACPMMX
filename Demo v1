const QRCode = ({ codigo, size = 120 }) => {
  const cells = useMemo(() => {
    const arr = [];
    for (let r = 0; r < 9; r++) for (let c = 0; c < 9; c++) {
      const edge = (r < 2 || r > 6 || c < 2 || c > 6);
      const hash = (codigo.charCodeAt(r % codigo.length) * 31 + c * 17 + r * 7) % 3;
      arr.push({ r, c, on: edge || hash === 0 });
    }
    return arr;
  }, [codigo]);
  const cell = size / 9;
  return (
    <svg width={size} height={size} style={{ border: `2px solid ${C.border}`, borderRadius: "8px", background: C.surface, display: "block" }}>
      {cells.map(({ r, c, on }) => on && (
        <rect key={`${r}-${c}`} x={c * cell} y={r * cell} width={cell} height={cell} fill={C.accent} />
      ))}
    </svg>
  );
};

