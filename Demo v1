// ── Calendar Section ─────────────────────────────────
function CalendarioSection() {
  const [calDate, setCalDate] = useState(new Date(2026, 2, 1)); // March 2026
  const [selectedEvent, setSelectedEvent] = useState(null);
  const year = calDate.getFullYear();
  const month = calDate.getMonth();
  const monthName = calDate.toLocaleString("es-AR", { month: "long", year: "numeric" });
  const firstDay = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const days = ["Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"];
  const cells = Array.from({ length: firstDay }, () => null).concat(
    Array.from({ length: daysInMonth }, (_, i) => i + 1)
  );
  const eventsForDay = d => {
    if (!d) return [];
    const dateStr = `${year}-${String(month + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
    return EVENTOS.filter(e => e.fecha === dateStr);
  };
  const upcoming = EVENTOS.filter(e => e.fecha >= today).slice(0, 5);
  const tipoColor = { Competencia: C.accent, Entrenamiento: C.teal, Especial: C.yellow, Circuito: C.muted };

  return (
    <Seccion titulo="🏆 Calendario de eventos" sub="Fechas del campeonato y actividades del circuito">
      <div style={{ display: "grid", gridTemplateColumns: typeof window !== "undefined" && window.innerWidth < 700 ? "1fr" : "1fr 280px", gap: "1.5rem", alignItems: "start" }}>
        {/* Calendar grid */}
        <div style={S.card}>
          {/* Month nav */}
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "1.25rem" }}>
            <button onClick={() => setCalDate(new Date(year, month - 1, 1))} style={{ background: C.surface, border: `1px solid ${C.border}`, color: C.text, borderRadius: "8px", padding: ".4rem .7rem", cursor: "pointer" }}>
              <ChevronLeft size={16} />
            </button>
            <div style={{ fontWeight: 800, color: C.white, fontSize: ".95rem", textTransform: "capitalize" }}>{monthName}</div>
            <button onClick={() => setCalDate(new Date(year, month + 1, 1))} style={{ background: C.surface, border: `1px solid ${C.border}`, color: C.text, borderRadius: "8px", padding: ".4rem .7rem", cursor: "pointer" }}>
              <ChevronRight size={16} />
            </button>
          </div>

          {/* Day headers */}
          <div style={{ display: "grid", gridTemplateColumns: "repeat(7, 1fr)", gap: "2px", marginBottom: ".5rem" }}>
            {days.map(d => (
              <div key={d} style={{ textAlign: "center", color: C.muted, fontSize: ".65rem", fontWeight: 700, padding: ".4rem 0", textTransform: "uppercase", letterSpacing: ".5px" }}>{d}</div>
            ))}
          </div>

          {/* Day cells */}
          <div style={{ display: "grid", gridTemplateColumns: "repeat(7, 1fr)", gap: "2px" }}>
            {cells.map((d, i) => {
              const evs = eventsForDay(d);
              const isToday = d && `${year}-${String(month + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}` === today;
              return (
                <div key={i} onClick={() => evs.length && setSelectedEvent(evs[0])} style={{
                  minHeight: "44px", borderRadius: "8px", padding: ".3rem .4rem",
                  background: isToday ? `${C.accent}18` : evs.length ? `${evs[0].color}10` : "transparent",
                  border: `1px solid ${isToday ? `${C.accent}40` : evs.length ? `${evs[0].color}25` : "transparent"}`,
                  cursor: evs.length ? "pointer" : "default",
                  transition: "background .15s",
                }}>
                  {d && (
                    <>
                      <div style={{
                        fontSize: ".78rem", fontWeight: isToday ? 900 : 500,
                        color: isToday ? C.accent : evs.length ? C.white : C.text,
                        textAlign: "right", marginBottom: ".2rem",
                      }}>{d}</div>
                      <div style={{ display: "flex", flexDirection: "column", gap: "2px" }}>
                        {evs.slice(0, 2).map(e => (
                          <div key={e.id} style={{
                            width: "6px", height: "6px", borderRadius: "50%",
                            background: e.color, marginLeft: "auto",
                          }} />
                        ))}
                      </div>
                    </>
                  )}
                </div>
              );
            })}
          </div>

          {/* Legend */}
          <div style={{ display: "flex", gap: ".75rem", marginTop: "1rem", paddingTop: ".75rem", borderTop: `1px solid ${C.border}`, flexWrap: "wrap" }}>
            {Object.entries(tipoColor).map(([tipo, color]) => (
              <div key={tipo} style={{ display: "flex", alignItems: "center", gap: ".4rem", fontSize: ".7rem" }}>
                <div style={{ width: "8px", height: "8px", borderRadius: "50%", background: color }} />
                <span style={{ color: C.text }}>{tipo}</span>
              </div>
            ))}
          </div>
        </div>

        {/* Upcoming events */}
        <div style={{ display: "flex", flexDirection: "column", gap: ".75rem" }}>
          <div style={{ color: C.white, fontWeight: 700, fontSize: ".88rem", marginBottom: ".25rem" }}>Próximos eventos</div>
          {upcoming.map(e => (
            <div key={e.id} onClick={() => setSelectedEvent(e)} style={{
              ...S.card, padding: "1rem", cursor: "pointer",
              borderLeft: `3px solid ${e.color}`,
              transition: "background .15s",
            }}
              onMouseEnter={el => el.currentTarget.style.background = C.cardHi}
              onMouseLeave={el => el.currentTarget.style.background = C.card}
            >
              <div style={{ display: "flex", gap: ".5rem", alignItems: "flex-start" }}>
                <div style={{
                  minWidth: "40px", height: "40px", borderRadius: "8px",
                  background: `${e.color}18`, border: `1px solid ${e.color}30`,
                  display: "flex", flexDirection: "column", alignItems: "center",
                  justifyContent: "center", fontSize: ".65rem", color: e.color, fontWeight: 800,
                }}>
                  <span>{new Date(e.fecha + "T12:00:00").toLocaleString("es-AR", { day: "numeric" })}</span>
                  <span style={{ textTransform: "uppercase", fontSize: ".55rem" }}>
                    {new Date(e.fecha + "T12:00:00").toLocaleString("es-AR", { month: "short" })}
                  </span>
                </div>
                <div style={{ flex: 1 }}>
                  <div style={{ fontWeight: 700, color: C.white, fontSize: ".8rem", lineHeight: 1.3 }}>{e.titulo}</div>
                  <span style={{ fontSize: ".65rem", color: e.color, fontWeight: 700, textTransform: "uppercase", letterSpacing: ".5px" }}>{e.tipo}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Event detail modal */}
      {selectedEvent && (
        <div onClick={() => setSelectedEvent(null)} style={{
          position: "fixed", inset: 0, background: "rgba(0,0,0,.7)",
          display: "flex", alignItems: "center", justifyContent: "center",
          zIndex: 400, padding: "1rem",
        }}>
          <div onClick={e => e.stopPropagation()} style={{
            ...S.card, maxWidth: "400px", width: "100%",
            borderTop: `3px solid ${selectedEvent.color}`,
            boxShadow: `0 20px 60px rgba(0,0,0,.5), 0 0 40px ${selectedEvent.color}15`,
          }}>
            <div style={{ fontWeight: 900, color: C.white, fontSize: "1.05rem", marginBottom: ".5rem" }}>{selectedEvent.titulo}</div>
            <div style={{ display: "flex", gap: ".5rem", marginBottom: "1rem", flexWrap: "wrap" }}>
              <span style={{ ...S.badge(true, selectedEvent.color) }}>{selectedEvent.tipo}</span>
              <span style={{ color: C.text, fontSize: ".8rem" }}>📅 {selectedEvent.fecha}</span>
            </div>
            <p style={{ color: C.text, fontSize: ".85rem", lineHeight: 1.7, marginBottom: "1rem" }}>{selectedEvent.desc}</p>
            <button onClick={() => setSelectedEvent(null)} style={{ ...S.btn(C.surface, C.text), width: "100%", border: `1px solid ${C.border}` }}>
              Cerrar
            </button>
          </div>
        </div>
      )}
    </Seccion>
  );
}

