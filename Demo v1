// CARRERAS PILOTO COMPONENT
// ════════════════════════════════════════════════════
function CarrerasPiloto({ db, piloto, session, today, fmt,
  inscripcionFlow, setInscripcionFlow, inscripcionDorsal, setInscripcionDorsal,
  inscribirse, S, C }) {
  const [carreraSelec, setCarreraSelec] = useState(null);

  const estaInscripto = (carrera) => carrera.inscriptos.some(i => i.username === session.username);
  const miInscripcion = (carrera) => carrera.inscriptos.find(i => i.username === session.username);
  const miPrecio = (carrera) => {
    const cat = carrera.categorias.find(c => c.cat === piloto.categoria);
    return cat ? cat.precio : null;
  };

  const carrerasAbiertas = db.carreras.filter(c => c.estado === "abierta" && c.fecha >= today);
  const carrerasCerradas = db.carreras.filter(c => c.estado !== "abierta" || c.fecha < today);

  // ── Modal de inscripción ──
  if (inscripcionFlow && carreraSelec) {
    const carrera = db.carreras.find(c => c.id === carreraSelec);
    const precio = miPrecio(carrera);
    if (inscripcionFlow === "confirm") return (
      <div>
        <button onClick={() => { setInscripcionFlow(null); setCarreraSelec(null); }} style={{ background:"none", border:"none", color:C.teal, cursor:"pointer", fontWeight:700, fontSize:".85rem", marginBottom:"1.25rem" }}>
          ← Volver
        </button>
        <div style={{ fontWeight:900, fontSize:"1.3rem", color:C.white, marginBottom:"1.5rem" }}>Inscripción a {carrera?.titulo}</div>

        <div style={{ ...S.card, marginBottom:"1.25rem" }}>
          <div style={{ fontWeight:700, color:C.white, marginBottom:"1rem" }}>✅ Tus datos de inscripción</div>
          {[
            ["Piloto", piloto.nombre],
            ["Categoría", piloto.categoria],
            ["Moto", piloto.moto],
            ["DNI", piloto.dni || "⚠️ No cargado — completá tu perfil"],
            ["Obra Social", piloto.obraSocial || "No indicada"],
            ["Contacto de emergencia", piloto.emergenciaNombre ? `${piloto.emergenciaNombre} (${piloto.emergenciaTel})` : "⚠️ No cargado"],
          ].map(([k,v]) => (
            <div key={k} style={{ display:"flex", gap:"1rem", padding:".5rem 0", borderBottom:`1px solid ${C.border}30`, alignItems:"flex-start" }}>
              <span style={{ minWidth:"130px", color:C.muted, fontSize:".8rem" }}>{k}</span>
              <span style={{ color:v.startsWith("⚠️")?C.yellow:C.textHi, fontSize:".85rem", fontWeight:600 }}>{v}</span>
            </div>
          ))}
          {piloto.esMenor && (
            <div key="tutor" style={{ display:"flex", gap:"1rem", padding:".5rem 0", alignItems:"flex-start" }}>
              <span style={{ minWidth:"130px", color:C.muted, fontSize:".8rem" }}>Tutor</span>
              <span style={{ color:C.textHi, fontSize:".85rem", fontWeight:600 }}>{piloto.tutorNombre||"⚠️ No cargado"} {piloto.tutorTel?"("+piloto.tutorTel+")":""}</span>
            </div>
          )}
        </div>

        <div style={S.card}>
          <label style={S.label}>Número de dorsal para esta carrera</label>
          <input style={{...S.input, maxWidth:"160px"}} placeholder={piloto.dorsal||"Ej: 11"}
            value={inscripcionDorsal} onChange={e => setInscripcionDorsal(e.target.value)} />
          <div style={{ display:"flex", alignItems:"center", justifyContent:"space-between", flexWrap:"wrap", gap:"1rem", marginTop:".5rem" }}>
            <div>
              <div style={{ color:C.text, fontSize:".8rem" }}>Precio de inscripción</div>
              <div style={{ fontSize:"1.5rem", fontWeight:900, color:precio===0?C.green:C.accent }}>{precio===0?"GRATIS":fmt(precio)}</div>
            </div>
            <button style={{ ...S.btn(precio===0?C.green:C.mp), fontSize:".9rem", padding:".75rem 1.5rem", boxShadow:`0 4px 15px ${precio===0?C.green:C.mp}30` }}
              onClick={() => setInscripcionFlow("pago")}>
              {precio===0?"Inscribirme gratis →":"Pagar con Mercado Pago →"}
            </button>
          </div>
        </div>
      </div>
    );

    if (inscripcionFlow === "pago") return (
      <div style={{ ...S.card, maxWidth:"400px", textAlign:"center", padding:"3rem 2rem" }}>
        <div style={{ fontSize:"3rem", marginBottom:"1rem" }}>⏳</div>
        <div style={{ fontWeight:800, fontSize:"1.1rem", color:C.white, marginBottom:".5rem" }}>Procesando pago...</div>
        <div style={{ color:C.text, fontSize:".85rem", marginBottom:"1.5rem" }}>Inscripción a {carrera?.titulo} — {precio===0?"GRATIS":fmt(precio)}</div>
        <button style={{ background:C.mp, color:"#fff", border:"none", padding:".85rem", borderRadius:"8px", fontWeight:700, cursor:"pointer", fontSize:".9rem", width:"100%" }}
          onClick={() => inscribirse(carreraSelec)}>
          ✅ Simular pago aprobado
        </button>
        <button style={{ background:"none", border:"none", color:C.muted, cursor:"pointer", marginTop:".75rem", fontSize:".82rem" }}
          onClick={() => setInscripcionFlow("confirm")}>Cancelar</button>
      </div>
    );

    if (inscripcionFlow === "listo") {
      const ins = miInscripcion(db.carreras.find(c => c.id === carreraSelec));
      return (
        <div style={{ ...S.card, maxWidth:"440px", textAlign:"center", padding:"2.5rem 2rem" }}>
          <div style={{ fontSize:"3rem", marginBottom:".5rem" }}>🏁</div>
          <div style={{ fontWeight:900, fontSize:"1.3rem", color:C.white, marginBottom:".3rem" }}>¡Inscripción confirmada!</div>
          <div style={{ color:C.text, fontSize:".85rem", marginBottom:"1.5rem" }}>{carrera?.titulo} · {carrera?.fecha}</div>
          <div style={{ background:C.surface, borderRadius:"10px", padding:"1rem", marginBottom:"1.25rem" }}>
            <div style={{ color:C.muted, fontSize:".72rem", marginBottom:".2rem" }}>CÓDIGO DE INSCRIPCIÓN</div>
            <div style={{ fontWeight:800, fontSize:"1.1rem", color:C.white, letterSpacing:"2px" }}>{ins?.codigo||"—"}</div>
            <div style={{ color:C.accent, fontWeight:900, fontSize:"1.5rem", marginTop:".5rem" }}>Dorsal #{ins?.dorsal||inscripcionDorsal||"—"}</div>
          </div>
          <div style={{ color:C.text, fontSize:".78rem", marginBottom:"1.2rem" }}>📲 Presentá este código el día de la carrera para confirmar tu presencia.</div>
          <button style={{ ...S.btn(C.accent), width:"100%", boxShadow:`0 4px 15px ${C.accent}30` }}
            onClick={() => { setInscripcionFlow(null); setCarreraSelec(null); }}>
            Ver todas las carreras
          </button>
        </div>
      );
    }
  }

  return (
    <div>
      <h2 style={{ fontWeight:900, fontSize:"1.3rem", color:C.white, margin:"0 0 .4rem" }}>🏁 Carreras</h2>
      <p style={{ color:C.text, fontSize:".85rem", margin:"0 0 1.5rem" }}>Inscribite a las próximas fechas y gestioná tus participaciones</p>

      {carrerasAbiertas.length > 0 && (
        <div style={{ marginBottom:"2rem" }}>
          <div style={{ fontWeight:700, color:C.teal, fontSize:".75rem", textTransform:"uppercase", letterSpacing:"1.5px", marginBottom:"1rem" }}>
            Inscripción abierta
          </div>
          <div style={{ display:"flex", flexDirection:"column", gap:"1rem" }}>
            {carrerasAbiertas.map(c => {
              const inscripto = estaInscripto(c);
              const ins = miInscripcion(c);
              const precio = miPrecio(c);
              const catHabilitada = precio !== null;
              return (
                <div key={c.id} style={{ ...S.cardGlow(inscripto?C.green:C.accent), borderLeft:`3px solid ${inscripto?C.green:C.accent}` }}>
                  <div style={{ display:"flex", justifyContent:"space-between", alignItems:"flex-start", flexWrap:"wrap", gap:"1rem" }}>
                    <div>
                      <div style={{ fontWeight:800, color:C.white, fontSize:".95rem" }}>{c.titulo}</div>
                      <div style={{ color:C.text, fontSize:".8rem", marginTop:".2rem" }}>📅 {c.fecha} · ⏰ {c.hora}</div>
                      {c.descripcion && <div style={{ color:C.muted, fontSize:".75rem", marginTop:".25rem" }}>{c.descripcion}</div>}
                    </div>
                    <div style={{ textAlign:"right" }}>
                      {catHabilitada
                        ? <div style={{ fontWeight:900, color:precio===0?C.green:C.accent, fontSize:"1.2rem" }}>{precio===0?"GRATIS":fmt(precio)}</div>
                        : <div style={{ color:C.muted, fontSize:".8rem" }}>Tu cat. no habilitada</div>
                      }
                      <div style={{ color:C.muted, fontSize:".7rem" }}>{piloto.categoria}</div>
                    </div>
                  </div>
                  <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginTop:"1rem", flexWrap:"wrap", gap:".75rem" }}>
                    <div style={{ color:C.muted, fontSize:".75rem" }}>{c.inscriptos.length} inscriptos · {c.categorias.length} categorías</div>
                    {inscripto ? (
                      <div style={{ display:"flex", alignItems:"center", gap:".75rem" }}>
                        <span style={{ ...S.badge(true), fontSize:".78rem" }}>✅ Inscripto · Dorsal #{ins.dorsal}</span>
                        <span style={{ fontSize:".72rem", color:C.muted }}>{ins.codigo}</span>
                      </div>
                    ) : catHabilitada ? (
                      <button style={{ ...S.btn(C.accent), fontSize:".82rem", padding:".55rem 1.1rem", boxShadow:`0 4px 12px ${C.accent}25` }}
                        onClick={() => { setCarreraSelec(c.id); setInscripcionFlow("confirm"); setInscripcionDorsal(piloto.dorsal||""); }}>
                        Inscribirme →
                      </button>
                    ) : (
                      <span style={{ color:C.muted, fontSize:".78rem" }}>Tu categoría no está habilitada</span>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {carrerasCerradas.length > 0 && (
        <div>
          <div style={{ fontWeight:700, color:C.muted, fontSize:".75rem", textTransform:"uppercase", letterSpacing:"1.5px", marginBottom:"1rem" }}>
            Historial de carreras
          </div>
          <div style={{ display:"flex", flexDirection:"column", gap:".75rem" }}>
            {carrerasCerradas.map(c => {
              const inscripto = estaInscripto(c);
              const ins = miInscripcion(c);
              return (
                <div key={c.id} style={{ ...S.card, borderLeft:`3px solid ${C.border}`, opacity:.8 }}>
                  <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", flexWrap:"wrap", gap:".5rem" }}>
                    <div>
                      <div style={{ fontWeight:700, color:C.textHi, fontSize:".88rem" }}>{c.titulo}</div>
                      <div style={{ color:C.muted, fontSize:".75rem" }}>📅 {c.fecha}</div>
                    </div>
                    <div style={{ display:"flex", gap:".5rem", alignItems:"center" }}>
                      {c.resultados && <a href={c.resultados.url} target="_blank" rel="noreferrer" style={{ ...S.badge(true, C.teal), textDecoration:"none", cursor:"pointer" }}>🏆 Ver resultados</a>}
                      {inscripto && <span style={{ ...S.badge(true) }}>✅ Participé · #{ins.dorsal}</span>}
                      <span style={{ ...S.badge(false, C.muted), fontSize:".7rem" }}>{c.estado==="finalizada"?"Finalizada":"Cerrada"}</span>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {db.carreras.length === 0 && (
        <div style={{ ...S.card, textAlign:"center", padding:"3rem", color:C.text }}>
          <Flag size={36} style={{ opacity:.3, marginBottom:"1rem", display:"block", margin:"0 auto 1rem" }}/>
          No hay carreras programadas todavía. El admin publicará las próximas fechas acá.
        </div>
      )}
    </div>
  );
}

