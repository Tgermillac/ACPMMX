    const anio = new Date().getFullYear();
    try {
      const res = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 400,
          messages: [{
            role: "user",
            content: [
              { type: "image", source: { type: "base64", media_type: mimeType, data: base64 } },
              { type: "text", text: `Analizá este comprobante de transferencia bancaria. Respondé SOLO con JSON válido, sin texto adicional.
Verificá:
1. ¿Está la fecha del comprobante en ${mesNombre} ${anio}? (mes y año actuales)
2. ¿El monto es de $${monto.toLocaleString("es-AR")}? (puede tener pequeña diferencia de centavos)
3. ¿Parece un comprobante bancario real (no una foto editada)?

Respondé exactamente así:
{"ok": true/false, "fecha_ok": true/false, "monto_ok": true/false, "real": true/false, "mensaje": "explicación breve en español"}` }
            ]
          }]
        })
      });
      const data = await res.json();
      const text = data.content?.find(b => b.type === "text")?.text || "{}";
