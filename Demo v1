// MI PERFIL PILOTO
// ════════════════════════════════════════════════════
function PerfilPiloto({ piloto, session, perfilEdit, setPerfilEdit, perfilForm, setPerfilForm, guardarPerfil, S, C }) {
  const startEdit = () => {
    setPerfilForm({ ...piloto });
    setPerfilEdit(true);
  };
  const data = perfilEdit ? perfilForm : piloto;
  const set = (k, v) => setPerfilForm(p => ({...p, [k]: v}));

  const Field = ({ label, k, type="text", placeholder="" }) => (
    <div>
      <label style={S.label}>{label}</label>
      {perfilEdit
        ? <input style={S.input} type={type} placeholder={placeholder} value={data[k]||""}
            onChange={e => set(k, e.target.value)} />
        : <div style={{ color:data[k]?C.textHi:C.muted, fontSize:".88rem", padding:".5rem 0",
            borderBottom:`1px solid ${C.border}30`, marginBottom:".85rem" }}>
            {data[k]||<span style={{fontStyle:"italic"}}>No cargado</span>}
          </div>
      }
    </div>
  );

  return (
    <div>
      <div style={{ display:"flex", justifyContent:"space-between", alignItems:"flex-start", flexWrap:"wrap", gap:"1rem", marginBottom:"1.5rem" }}>
        <div>
          <h2 style={{ fontWeight:900, fontSize:"1.3rem", color:C.white, margin:0 }}>👤 Mi perfil</h2>
          <p style={{ color:C.text, fontSize:".85rem", margin:".3rem 0 0" }}>Tus datos personales y de seguridad en el circuito</p>
        </div>
        {!perfilEdit
          ? <button style={{ ...S.btn(C.accent), display:"flex", alignItems:"center", gap:".5rem" }} onClick={startEdit}>✏️ Editar perfil</button>
          : <div style={{ display:"flex", gap:".6rem" }}>
              <button style={{ ...S.btn(C.green) }} onClick={guardarPerfil}>✅ Guardar</button>
              <button style={{ ...S.btn(C.surface, C.text), border:`1px solid ${C.border}` }} onClick={() => setPerfilEdit(false)}>Cancelar</button>
            </div>
        }
      </div>

      {(!piloto.dni || !piloto.emergenciaNombre) && !perfilEdit && (
        <div style={{ background:`${C.yellow}12`, border:`1px solid ${C.yellow}30`, borderRadius:"10px", padding:".85rem 1rem", marginBottom:"1.25rem", display:"flex", gap:".75rem", alignItems:"center" }}>
          <AlertCircle size={18} style={{ color:C.yellow, flexShrink:0 }} />
          <div style={{ fontSize:".82rem", color:C.yellow }}>
            <strong>Completá tu perfil</strong> — Faltan datos importantes de seguridad (DNI, contacto de emergencia). El equipo del circuito los necesita ante cualquier incidente.
          </div>
        </div>
      )}

      <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit,minmax(280px,1fr))", gap:"1.25rem" }}>

        {/* Datos de piloto */}
        <div style={S.card}>
          <div style={{ fontWeight:700, color:C.white, marginBottom:"1.25rem", fontSize:".88rem", display:"flex", alignItems:"center", gap:".5rem" }}>
            <User size={16} style={{ color:C.accent }} /> Datos del piloto
          </div>
          <Field label="Nombre completo" k="nombre" />
          <Field label="Moto (modelo)" k="moto" placeholder="YZ450F, CRF250R..." />
          <Field label="Número de dorsal habitual" k="dorsal" placeholder="Ej: 11" />
          <Field label="DNI" k="dni" placeholder="Sin puntos" />
          <Field label="Obra Social" k="obraSocial" placeholder="OSDE, PAMI, IOMA..." />
          {perfilEdit && (
            <div style={{ marginBottom:".85rem" }}>
              <label style={S.label}>¿Es menor de edad?</label>
              <div style={{ display:"flex", gap:"1rem" }}>
                {[["Sí", true],["No", false]].map(([l, v]) => (
                  <label key={l} style={{ display:"flex", alignItems:"center", gap:".4rem", cursor:"pointer", color:C.text, fontSize:".85rem" }}>
                    <input type="radio" name="esMenor" checked={data.esMenor===v} onChange={() => set("esMenor", v)}
                      style={{ accentColor:C.accent }} /> {l}
                  </label>
                ))}
              </div>
            </div>
          )}
          {!perfilEdit && (
            <div style={{ padding:".5rem 0", borderBottom:`1px solid ${C.border}30`, marginBottom:".85rem" }}>
              <div style={{ color:C.muted, fontSize:".72rem", fontWeight:700, textTransform:"uppercase", marginBottom:".3rem", letterSpacing:"1px" }}>Menor de edad</div>
              <span style={S.badge(piloto.esMenor, piloto.esMenor?C.yellow:C.muted)}>{piloto.esMenor?"Sí, es menor":"No"}</span>
            </div>
          )}
        </div>

        {/* Contacto de emergencia */}
        <div style={S.card}>
          <div style={{ fontWeight:700, color:C.white, marginBottom:"1.25rem", fontSize:".88rem", display:"flex", alignItems:"center", gap:".5rem" }}>
            <AlertCircle size={16} style={{ color:C.red }} /> Contacto de emergencia
          </div>
          <Field label="Nombre completo" k="emergenciaNombre" placeholder="Nombre del contacto" />
          <Field label="Teléfono" k="emergenciaTel" type="tel" placeholder="2974..." />
          <Field label="Vínculo" k="emergenciaVinculo" placeholder="Madre, Padre, Pareja..." />

          {(data.esMenor) && (
            <div style={{ borderTop:`1px solid ${C.border}`, paddingTop:"1rem", marginTop:".5rem" }}>
              <div style={{ fontWeight:700, color:C.yellow, marginBottom:"1rem", fontSize:".82rem", display:"flex", alignItems:"center", gap:".5rem" }}>
                👶 Datos del tutor (menor de edad)
              </div>
              <Field label="Nombre del tutor" k="tutorNombre" placeholder="Nombre completo" />
              <Field label="DNI del tutor" k="tutorDni" placeholder="Sin puntos" />
              <Field label="Teléfono del tutor" k="tutorTel" type="tel" placeholder="2974..." />
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

// ════════════════════════════════════════════════════
// MAIN APP
// ════════════════════════════════════════════════════
export default function App() {
  const [darkMode, setDarkMode] = useState(true);
  // Update module-level C and S on theme change (triggers full re-render)
  isDark = darkMode;
  C = isDark ? DARK_THEME : LIGHT_THEME;
  S = buildS(C);

  const [db, setDb] = useState(INIT);
  const [session, setSession] = useState(null);
  const [page, setPage] = useState("landing");
  const [isMobile, setIsMobile] = useState(typeof window !== "undefined" && window.innerWidth < 700);
  // eslint-disable-next-line
  useState(() => {
    const handler = () => setIsMobile(window.innerWidth < 700);
    window.addEventListener("resize", handler);
    return () => window.removeEventListener("resize", handler);
  });
  const [sideTab, setSideTab] = useState("inicio");
  const [loginD, setLoginD] = useState({ user: "", pass: "", error: "" });
  const [regD, setRegD] = useState({ user: "", pass: "", nombre: "", moto: "", nivel: "Principiante", categoria: "MX1",
    dni: "", obraSocial: "", esMenor: false,
    emergenciaNombre: "", emergenciaTel: "", emergenciaVinculo: "Madre",
    tutorNombre: "", tutorDni: "", tutorTel: "",
    dorsal: "", error: "" });
  const [fotoD, setFotoD] = useState({ nombre: "", email: "", instagram: "", error: "" });
  const [pagoModal, setPagoModal] = useState(null);
  const [pagoForm, setPagoForm] = useState({ tipo: "Mensual", monto: PRECIO_MES, fecha: today });
  const [qrModal, setQrModal] = useState(null);
  const [busqueda, setBusqueda] = useState("");
  const [toast, setToast] = useState("");
  const [transFlow, setTransFlow] = useState(null); // null | "datos" | "subir" | "verificando" | "enviado"
  const [transTipo, setTransTipo] = useState("Mensual");
  const [transImg, setTransImg] = useState(null); // { base64, mimeType, name }
  const [transVerif, setTransVerif] = useState(null); // { ok, mensaje }
  const [mpFlow, setMpFlow] = useState(null); // kept for carrera inscripcion compat
  const [mpTipo, setMpTipo] = useState("Mensual");
  const [carreraModal, setCarreraModal] = useState(null); // carrera being viewed/inscribed
  const [carreraForm, setCarreraForm] = useState({ titulo:"", fecha:"", hora:"09:00", descripcion:"",
    categorias: categorias.map(c=>({cat:c, precio:5000, habilitada:true})) });
  const [inscripcionFlow, setInscripcionFlow] = useState(null); // null|"confirm"|"pago"|"listo"
  const [inscripcionDorsal, setInscripcionDorsal] = useState("");
  const [presenciaCarrera, setPresenciaCarrera] = useState(null); // carreraId being managed

  // Inject viewport meta for proper mobile scaling
  useState(() => {
    if (typeof document !== "undefined") {
      let meta = document.querySelector("meta[name=viewport]");
      if (!meta) {
        meta = document.createElement("meta");
        meta.name = "viewport";
        document.head.appendChild(meta);
      }
      meta.content = "width=device-width, initial-scale=1, maximum-scale=1";
    }
  });

  const showToast = msg => { setToast(msg); setTimeout(() => setToast(""), 3500); };
  const piloto = session ? db.users[session.username] : null;
  const isAdmin = session?.role === "admin";
  const pilotos = Object.entries(db.users).filter(([, v]) => v.role === "piloto");

  // Auth
  const login = () => {
    const u = db.users[loginD.user.toLowerCase()];
    if (!u || u.pass !== loginD.pass) return setLoginD(p => ({ ...p, error: "Usuario o contraseña incorrectos." }));
    setSession({ username: loginD.user.toLowerCase(), ...u });
    setPage("dashboard"); setSideTab(u.role === "admin" ? "pilotos" : "inicio");
    setLoginD({ user: "", pass: "", error: "" });
  };
  const registro = () => {
    const { user, pass, nombre, moto, nivel, categoria, dni, obraSocial, esMenor,
            emergenciaNombre, emergenciaTel, emergenciaVinculo,
            tutorNombre, tutorDni, tutorTel, dorsal } = regD;
    if (!user || !pass || !nombre || !moto) return setRegD(p => ({ ...p, error: "Completá todos los campos obligatorios." }));
    if (db.users[user.toLowerCase()]) return setRegD(p => ({ ...p, error: "Ese usuario ya existe." }));
    if (pass.length < 6) return setRegD(p => ({ ...p, error: "Contraseña mínimo 6 caracteres." }));
    const nuevo = { pass, role: "piloto", nombre, moto, nivel, categoria, estado: "vencido", pagos: [],
      dni, obraSocial, esMenor, emergenciaNombre, emergenciaTel, emergenciaVinculo,
      tutorNombre, tutorDni, tutorTel, dorsal };
    setDb(d => ({ ...d, users: { ...d.users, [user.toLowerCase()]: nuevo } }));
    setSession({ username: user.toLowerCase(), ...nuevo });
    setPage("dashboard"); setSideTab("inicio");
    showToast("✅ ¡Bienvenido/a a ACPM!");
  };
  const regFoto = () => {
    const { nombre, email, instagram } = fotoD;
    if (!nombre || !email || !instagram) return setFotoD(p => ({ ...p, error: "Completá todos los campos." }));
    const nueva = { id: Date.now(), nombre, instagram, email, estado: "pendiente", fecha: today };
    setDb(d => ({ ...d, fotografos: [...d.fotografos, nueva] }));
    setFotoD({ nombre: "", email: "", instagram: "", error: "" });
    setPage("landing");
    showToast("✅ Solicitud enviada.");
  };
  const logout = () => { setSession(null); setPage("landing"); };

  const procesarPago = () => {
    const codigo = `ACPM-${String(new Date().getMonth() + 1).padStart(2, "0")}-${String(Math.floor(Math.random() * 900) + 100)}`;
    const monto = mpTipo === "Mensual" ? PRECIO_MES : PRECIO_DIA;
    const pago = { id: Date.now(), tipo: mpTipo, monto, fecha: today, codigo };
    setDb(d => {
      const u = { ...d.users[session.username], pagos: [pago, ...d.users[session.username].pagos], estado: "al_dia" };
